<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodel="clr-namespace:OrionVault.ViewModels"
    xmlns:converters="clr-namespace:OrionVault.Converters"
    xmlns:controls="clr-namespace:Maui.ColorPicker;assembly=Maui.ColorPicker"
    x:Class="OrionVault.Views.EditFolderPage"
    x:DataType="viewmodel:EditFolderPageViewModel"
    Title="{Binding PageTitle}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:EditingModeToColorConverter x:Key="EditingModeToColorConverter" />
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Modern Header -->
        <Border Grid.Row="0" 
                Background="{StaticResource SurfaceGradient}"
                Padding="0,50,0,32"
                StrokeShape="RoundRectangle 0,0,28,28">

            <StackLayout Spacing="20">

                <Grid ColumnDefinitions="Auto,*,Auto" 
                      ColumnSpacing="16"
                      HorizontalOptions="Center">

                    <Border Grid.Column="0"
                            WidthRequest="48" HeightRequest="48"
                            BackgroundColor="{StaticResource Primary}"
                            StrokeShape="RoundRectangle 16">

                        <Border.Shadow>
                            <Shadow Brush="{StaticResource Primary}" Offset="0,4" Radius="12" Opacity="0.3" />
                        </Border.Shadow>

                        <Label Text="folder"
                               FontFamily="MaterialIcons"
                               FontSize="24"
                               TextColor="{StaticResource PrimaryDarkText}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <StackLayout Grid.Column="1" 
                                 VerticalOptions="Center"
                                 Spacing="4">

                        <Label Text="{Binding HeaderTitle}"
                               Style="{StaticResource HeadlineStyle}"
                               FontSize="24"
                               TextColor="{StaticResource Primary}"
                               HorizontalTextAlignment="Start" />

                        <Label Text="{Binding HeaderSubtitle}"
                               Style="{StaticResource CaptionStyle}"
                               Opacity="0.8"
                               HorizontalTextAlignment="Start" />

                    </StackLayout>
                </Grid>
            </StackLayout>
        </Border>

        <!-- Scrollable Content -->
        <ScrollView Grid.Row="1" Padding="24,20,24,20">
            <StackLayout Spacing="32">
                <!-- Main Information Card -->
                <Border Style="{StaticResource ElevatedCardStyle}">
                    <StackLayout Spacing="28">
                        <!-- Form Header -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Grid.Column="0"
                                   Text="edit_note"
                                   FontFamily="MaterialIcons"
                                   FontSize="20"
                                   TextColor="{StaticResource Primary}"
                                   VerticalOptions="Center" />
                            <StackLayout Grid.Column="1" Spacing="4">
                                <Label Text="{Binding FormSectionTitle}"
                                       Style="{StaticResource TitleStyle}"
                                       FontSize="16"
                                       TextColor="{StaticResource Primary}" />
                                <Label Text="{Binding FormSectionSubtitle}"
                                       Style="{StaticResource CaptionStyle}"
                                       Opacity="0.8" />
                            </StackLayout>
                        </Grid>

                        <!-- Title Field -->
                        <StackLayout Spacing="12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="drive_file_rename_outline"
                                       FontFamily="MaterialIcons"
                                       FontSize="16"
                                       TextColor="{StaticResource Primary}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding FolderNameLabel}"
                                       Style="{StaticResource CaptionStyle}"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}"
                                       VerticalOptions="Center" />
                            </Grid>
                            <Border Style="{StaticResource EntryContainerStyle}">
                                <Entry Placeholder="{Binding FolderNamePlaceholder}"
                                       Text="{Binding Title}"
                                       IsReadOnly="{Binding IsEditing, Converter={StaticResource InverseBooleanConverter}}"
                                       Style="{StaticResource DefaultEntryStyle}" />
                            </Border>
                        </StackLayout>

                        <!-- Color Selection -->
                        <StackLayout Spacing="12" HorizontalOptions="Center">
                            <Label Text="{Binding ColorLabel}"
                                   Style="{StaticResource CaptionStyle}"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}"
                                   HorizontalTextAlignment="Center" />
                            <Border WidthRequest="60" HeightRequest="60"
                                    BackgroundColor="{Binding SelectedColor}"
                                    StrokeShape="RoundRectangle 20"
                                    IsEnabled="{Binding IsEditing}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleColorPickerCommand}" />
                                </Border.GestureRecognizers>
                                <Border.Shadow>
                                    <Shadow Brush="{Binding SelectedColor}" Offset="0,6" Radius="16" Opacity="0.4" />
                                </Border.Shadow>
                                <Grid>
                                    <Ellipse WidthRequest="32" HeightRequest="32"
                                             Fill="#40FFFFFF"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center" />
                                    <Label Text="palette"
                                           FontFamily="MaterialIcons"
                                           FontSize="20"
                                           TextColor="{StaticResource PrimaryDarkText}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </StackLayout>

                        <!-- Parent Folder Selection -->
                        <StackLayout Spacing="16">
                            <Label Text="{Binding OrganizationLabel}"
                                   Style="{StaticResource CaptionStyle}"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}" />
                            <StackLayout Spacing="8">
                                <Label Text="{Binding ParentFolderLabel}"
                                       Style="{StaticResource CaptionStyle}"
                                       FontSize="12"
                                       TextColor="{StaticResource TextTertiary}" />
                                <Border Style="{StaticResource EntryContainerStyle}"
                                        IsEnabled="{Binding IsEditing}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="4,0">
                                        <Label Grid.Column="0"
                                               Text="folder_open"
                                               FontFamily="MaterialIcons"
                                               FontSize="18"
                                               TextColor="{StaticResource Primary}"
                                               VerticalOptions="Center" />
                                        <Label Grid.Column="1"
                                               Text="{Binding SelectedFolderName}"
                                               Style="{StaticResource BodyStyle}"
                                               VerticalOptions="Center" />
                                        <Label Grid.Column="2"
                                               Text="arrow_drop_down"
                                               FontFamily="MaterialIcons"
                                               FontSize="24"
                                               TextColor="{StaticResource TextTertiary}"
                                               VerticalOptions="Center" />
                                    </Grid>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectFolderCommand}" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </StackLayout>
                        </StackLayout>
                    </StackLayout>
                </Border>
            </StackLayout>
        </ScrollView>

        <!-- Fixed Action Buttons -->
        <Border Grid.Row="2"
                VerticalOptions="End"
                HorizontalOptions="Fill"
                BackgroundColor="{StaticResource Background}"
                Padding="24,16,24,32">
            <Border.Shadow>
                <Shadow Brush="#40000000" Offset="0,-4" Radius="16" Opacity="0.1" />
            </Border.Shadow>
            <Grid>
                <Button Text="{Binding EditButtonText}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ToggleEditModeCommand}"
                        HorizontalOptions="FillAndExpand"
                        IsVisible="{Binding IsEditing, Converter={StaticResource InverseBooleanConverter}}"
                        ImageSource="{FontImageSource FontFamily=MaterialIcons, Glyph=edit, Color={StaticResource TextPrimary}, Size=18}" />

                <Button Text="{Binding SaveButtonText}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding SaveFolderCommand}"
                        HorizontalOptions="FillAndExpand"
                        IsVisible="{Binding IsEditing}"
                        ImageSource="{FontImageSource FontFamily=MaterialIcons, Glyph=save, Color={StaticResource PrimaryDarkText}, Size=18}" />
            </Grid>
        </Border>

        <!-- Color Picker Modal -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              IsVisible="{Binding IsColorPickerVisible}"
              BackgroundColor="#80000000">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseColorPickerCommand}" />
            </Grid.GestureRecognizers>
            <!-- Color Picker Card -->
            <Border Style="{StaticResource FloatingCardStyle}"
                    MaximumWidthRequest="380"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Margin="24">
                <StackLayout Spacing="24">
                    <!-- Modal Header -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackLayout Grid.Column="0" Spacing="4">
                            <Label Text="{Binding CustomColorTitle}"
                                   Style="{StaticResource TitleStyle}"
                                   FontSize="20"
                                   TextColor="{StaticResource Primary}" />
                            <Label Text="{Binding CustomColorSubtitle}"
                                   Style="{StaticResource CaptionStyle}"
                                   Opacity="0.8" />
                        </StackLayout>
                        <Border Grid.Column="1"
                                WidthRequest="32" HeightRequest="32"
                                BackgroundColor="{StaticResource SurfaceBackground}"
                                StrokeShape="RoundRectangle 10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CloseColorPickerCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="close"
                                   FontFamily="MaterialIcons"
                                   FontSize="16"
                                   TextColor="{StaticResource TextTertiary}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </Grid>
                    <!-- Color Picker Control -->
                    <controls:ColorPicker 
                        PickedColor="{Binding SelectedColor, Mode=TwoWay}"
                        WidthRequest="300"
                        HeightRequest="200" />
                    <!-- Color Preview -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <Border Grid.Column="0"
                                WidthRequest="60" HeightRequest="60"
                                BackgroundColor="{Binding SelectedColor}"
                                StrokeShape="RoundRectangle 20"
                                Stroke="{StaticResource BorderPrimary}">
                            <Border.Shadow>
                                <Shadow Brush="{Binding SelectedColor}" Offset="0,4" Radius="12" Opacity="0.3" />
                            </Border.Shadow>
                        </Border>
                        <StackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                            <Label Text="{Binding SelectedColorLabel}"
                                   Style="{StaticResource CaptionStyle}"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />
                            <Label Text="{Binding SelectedColorHex}"
                                   Style="{StaticResource CaptionStyle}"
                                   Opacity="0.8" />
                        </StackLayout>
                    </Grid>
                    <!-- Action Button -->
                    <Button Text="{Binding ApplyColorButtonText}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding CloseColorPickerCommand}"
                            ImageSource="{FontImageSource FontFamily=MaterialIcons, Glyph=check, Color={StaticResource PrimaryDarkText}, Size=18}" />
                </StackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
