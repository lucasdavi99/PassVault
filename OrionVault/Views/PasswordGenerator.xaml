<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:OrionVault.ViewModels"
             xmlns:converters="clr-namespace:OrionVault.Converters"
             x:DataType="viewmodel:PasswordGeneratorViewModel"
             x:Class="OrionVault.Views.PasswordGenerator"             
             Title="{Binding PageTitle}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:StringIsNotNullOrEmptyConverter x:Key="StringIsNotNullOrEmptyConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <StackLayout Spacing="24" Padding="24">

            <!-- Header -->
            <StackLayout Spacing="8" Margin="0,20,0,16">
                <Label Text="{Binding PageTitle}"
                       Style="{StaticResource HeadlineStyle}"
                       TextColor="{StaticResource Primary}" />

                <Label Text="{Binding PageSubtitle}"
                       Style="{StaticResource BodyStyle}"
                       HorizontalTextAlignment="Center" />
            </StackLayout>

            <!-- Configuration Section -->
            <Border Style="{StaticResource ElevatedCardStyle}">
                <StackLayout Spacing="20">

                    <Label Text="{Binding ConfigTitle}"
                           Style="{StaticResource TitleStyle}"
                           TextColor="{StaticResource Primary}"
                           FontSize="18" />

                    <!-- Length Settings -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16" RowSpacing="16">

                        <!-- Min Length -->
                        <StackLayout Grid.Column="0" Spacing="8">
                            <Label Text="{Binding MinLengthLabel}"
                                   Style="{StaticResource CaptionStyle}"
                                   FontAttributes="Bold" />

                            <Border Style="{StaticResource EntryContainerStyle}">
                                <Entry Text="{Binding MinLength}"
                                       Style="{StaticResource ModernEntryStyle}"
                                       Keyboard="Numeric"
                                       Placeholder="{Binding MinLengthPlaceholder}" />
                            </Border>
                        </StackLayout>

                        <!-- Max Length -->
                        <StackLayout Grid.Column="1" Spacing="8">
                            <Label Text="{Binding MaxLengthLabel}"
                                   Style="{StaticResource CaptionStyle}"
                                   FontAttributes="Bold" />

                            <Border Style="{StaticResource EntryContainerStyle}">
                                <Entry Text="{Binding MaxLength}"
                                       Style="{StaticResource ModernEntryStyle}"
                                       Keyboard="Numeric"
                                       Placeholder="{Binding MaxLengthPlaceholder}" />
                            </Border>
                        </StackLayout>

                    </Grid>

                    <!-- Character Type Options -->
                    <StackLayout Spacing="16">

                        <!-- Include Numbers -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border Grid.Column="0"
                                    WidthRequest="32" HeightRequest="32"
                                    BackgroundColor="{StaticResource Info}"
                                    StrokeShape="RoundRectangle 8">

                                <Label Text="123"
                                       TextColor="White"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <Label Grid.Column="1"
                                   Text="{Binding IncludeNumbersLabel}"
                                   Style="{StaticResource BodyStyle}"
                                   VerticalOptions="Center" />

                            <Switch Grid.Column="2"
                                    IsToggled="{Binding IncludeNumbers}"
                                    ThumbColor="{StaticResource Primary}"
                                    OnColor="{StaticResource Primary}"
                                    VerticalOptions="Center" />
                        </Grid>

                        <!-- Include Special Characters -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border Grid.Column="0"
                                    WidthRequest="32" HeightRequest="32"
                                    BackgroundColor="{StaticResource Warning}"
                                    StrokeShape="RoundRectangle 8">

                                <Label Text="@#$"
                                       TextColor="White"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <Label Grid.Column="1"
                                   Text="{Binding IncludeSpecialCharsLabel}"
                                   Style="{StaticResource BodyStyle}"
                                   VerticalOptions="Center" />

                            <Switch Grid.Column="2"
                                    IsToggled="{Binding IncludeSpecialChars}"
                                    ThumbColor="{StaticResource Primary}"
                                    OnColor="{StaticResource Primary}"
                                    VerticalOptions="Center" />
                        </Grid>

                    </StackLayout>

                </StackLayout>
            </Border>

            <!-- Generate Button -->
            <Button Text="{Binding GenerateButtonText}" 
                    Style="{StaticResource ModernButtonStyle}"
                    FontSize="18"
                    HeightRequest="56"
                    Command="{Binding GeneratePasswordCommand}">

                <Button.ImageSource>
                    <FontImageSource FontFamily="MaterialIcons"
                                     Glyph="auto_awesome"
                                     Color="{StaticResource PrimaryDarkText}"
                                     Size="20" />
                </Button.ImageSource>

            </Button>

            <!-- Generated Password Display -->
            <Border Style="{StaticResource ElevatedCardStyle}"
                    IsVisible="{Binding GeneratedPassword, Converter={StaticResource StringIsNotNullOrEmptyConverter}}"
                    BackgroundColor="{StaticResource Success}"
                    Stroke="{StaticResource Success}">

                <StackLayout Spacing="16">

                    <Label Text="{Binding GeneratedPasswordTitle}"
                           Style="{StaticResource TitleStyle}"
                           TextColor="White"
                           FontSize="16" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">

                        <!-- Password Display -->
                        <Border Grid.Column="0"
                                BackgroundColor="White"
                                StrokeShape="RoundRectangle 8"
                                Padding="16,12">

                            <Label Text="{Binding GeneratedPassword}" 
                                   FontFamily="Courier"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   TextColor="{StaticResource Black}"
                                   LineBreakMode="CharacterWrap"
                                   HorizontalTextAlignment="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <!-- Copy Button -->
                        <Button Grid.Column="1"
                                Text="content_copy"
                                FontFamily="MaterialIcons"
                                BackgroundColor="White"
                                TextColor="{StaticResource Success}"
                                Style="{StaticResource IconButtonStyle}"
                                Command="{Binding CopyPasswordCommand}" />

                    </Grid>

                    <Label Text="{Binding CopyPasswordTooltip}"
                           Style="{StaticResource CaptionStyle}"
                           TextColor="White"
                           HorizontalTextAlignment="Center"
                           Opacity="0.9" />

                </StackLayout>
            </Border>

            <!-- Security Tips -->
            <Border Style="{StaticResource CardStyle}"
                    Stroke="{StaticResource Info}"
                    BackgroundColor="{StaticResource ElevatedSurface}">

                <StackLayout Spacing="12">

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Grid.Column="0"
                               Text="security"
                               FontFamily="MaterialIcons"
                               FontSize="20"
                               TextColor="{StaticResource Info}"
                               VerticalOptions="Start" />

                        <Label Grid.Column="1"
                               Text="{Binding SecurityTipsTitle}"
                               Style="{StaticResource TitleStyle}"
                               FontSize="16"
                               TextColor="{StaticResource Info}" />
                    </Grid>

                    <Label Text="{Binding Tip1}"
                           Style="{StaticResource CaptionStyle}" />

                    <Label Text="{Binding Tip2}"
                           Style="{StaticResource CaptionStyle}" />

                    <Label Text="{Binding Tip3}"
                           Style="{StaticResource CaptionStyle}" />

                    <Label Text="{Binding Tip4}"
                           Style="{StaticResource CaptionStyle}" />

                </StackLayout>
            </Border>

            <!-- Bottom Spacing -->
            <BoxView HeightRequest="20" BackgroundColor="Transparent" />

        </StackLayout>
    </ScrollView>
</ContentPage>