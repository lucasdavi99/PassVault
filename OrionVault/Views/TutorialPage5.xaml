<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:OrionVault.ViewModels"
             x:Class="OrionVault.Views.TutorialPage5"
             x:DataType="viewModels:TutorialPage5ViewModel"
             Shell.NavBarIsVisible="False"
             Title="TutorialPage5">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Hero Section with Celebration -->
        <StackLayout Grid.Row="0" 
                     Spacing="20" 
                     Padding="24,60,24,16">

            <!-- Success Icon with Celebration Effect -->
            <Grid HorizontalOptions="Center">

                <!-- Main success icon -->
                <Border WidthRequest="80" HeightRequest="80"
                        BackgroundColor="{StaticResource Success}"
                        StrokeShape="RoundRectangle 24"
                        HorizontalOptions="Center">

                    <Border.Shadow>
                        <Shadow Brush="{StaticResource Success}" Offset="0,8" Radius="24" Opacity="0.3" />
                    </Border.Shadow>

                    <Label Text="celebration"
                           FontFamily="MaterialIcons"
                           FontSize="36"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

                </Border>

                <!-- Celebration stars -->
                <Label Text="star"
                       FontFamily="MaterialIcons"
                       FontSize="16"
                       TextColor="{StaticResource Warning}"
                       Margin="-60,-40,0,0"
                       HorizontalOptions="Start"
                       VerticalOptions="Start" />

                <Label Text="star"
                       FontFamily="MaterialIcons"
                       FontSize="12"
                       TextColor="{StaticResource Primary}"
                       Margin="60,-30,0,0"
                       HorizontalOptions="End"
                       VerticalOptions="Start" />

                <Label Text="star"
                       FontFamily="MaterialIcons"
                       FontSize="14"
                       TextColor="{StaticResource Info}"
                       Margin="-50,60,0,0"
                       HorizontalOptions="Start"
                       VerticalOptions="End" />

                <Label Text="star"
                       FontFamily="MaterialIcons"
                       FontSize="10"
                       TextColor="{StaticResource Success}"
                       Margin="50,50,0,0"
                       HorizontalOptions="End"
                       VerticalOptions="End" />

            </Grid>

            <!-- Congratulations Title -->
            <StackLayout Spacing="12" HorizontalOptions="Center">
                <Label Text="{Binding Congratulations}"
                       Style="{StaticResource DisplayStyle}"
                       FontSize="32"
                       TextColor="{StaticResource Success}"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center">

                    <Label.Shadow>
                        <Shadow Brush="{StaticResource Success}" Offset="0,4" Radius="16" Opacity="0.3" />
                    </Label.Shadow>

                </Label>

                <Label Text="{Binding Title}"
                       Style="{StaticResource HeadlineStyle}"
                       FontSize="20"
                       TextColor="{StaticResource Primary}"
                       HorizontalTextAlignment="Center"
                       LineHeight="1.3" />
            </StackLayout>

        </StackLayout>

        <!-- Content Section -->
        <ScrollView Grid.Row="1" Padding="24,0,24,0">
            <StackLayout Spacing="24">

                <!-- Ready to Start -->
                <Label Text="{Binding ReadyToStartMessage}"
                       Style="{StaticResource BodyStyle}"
                       FontSize="16"
                       HorizontalTextAlignment="Center"
                       LineHeight="1.5"
                       Margin="0,0,0,16" />

                <!-- Feature Summary -->
                <StackLayout Spacing="12">

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Grid.Column="0"
                               Text="add_circle"
                               FontFamily="MaterialIcons"
                               FontSize="18"
                               TextColor="{StaticResource Primary}"
                               VerticalOptions="Center" />

                        <Label Grid.Column="1"
                               Text="{Binding CreateAndOrganize}"
                               Style="{StaticResource CaptionStyle}"
                               FontSize="14"
                               VerticalOptions="Center" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Grid.Column="0"
                               Text="auto_awesome"
                               FontFamily="MaterialIcons"
                               FontSize="18"
                               TextColor="{StaticResource Warning}"
                               VerticalOptions="Center" />

                        <Label Grid.Column="1"
                               Text="{Binding GenerateSecurePasswords}"
                               Style="{StaticResource CaptionStyle}"
                               FontSize="14"
                               VerticalOptions="Center" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Grid.Column="0"
                               Text="search"
                               FontFamily="MaterialIcons"
                               FontSize="18"
                               TextColor="{StaticResource Info}"
                               VerticalOptions="Center" />

                        <Label Grid.Column="1"
                               Text="{Binding SearchAndAccess}"
                               Style="{StaticResource CaptionStyle}"
                               FontSize="14"
                               VerticalOptions="Center" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Grid.Column="0"
                               Text="backup"
                               FontFamily="MaterialIcons"
                               FontSize="18"
                               TextColor="{StaticResource Success}"
                               VerticalOptions="Center" />

                        <Label Grid.Column="1"
                               Text="{Binding BackupData}"
                               Style="{StaticResource CaptionStyle}"
                               FontSize="14"
                               VerticalOptions="Center" />
                    </Grid>

                </StackLayout>

                <!-- Welcome Badge -->
                <Border Style="{StaticResource CardStyle}"
                        BackgroundColor="{StaticResource Primary}"
                        MaximumWidthRequest="260"
                        HorizontalOptions="Center"
                        Padding="16,12">

                    <Border.Shadow>
                        <Shadow Brush="{StaticResource Primary}" Offset="0,6" Radius="20" Opacity="0.25" />
                    </Border.Shadow>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Grid.Column="0"
                               Text="emoji_events"
                               FontFamily="MaterialIcons"
                               FontSize="24"
                               TextColor="{StaticResource PrimaryDarkText}"
                               VerticalOptions="Center" />

                        <StackLayout Grid.Column="1" Spacing="2">
                            <Label Text="{Binding Welcome}"
                                   Style="{StaticResource TitleStyle}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource PrimaryDarkText}" />

                            <Label Text="{Binding YouAreNowAUser}"
                                   Style="{StaticResource CaptionStyle}"
                                   FontSize="11"
                                   TextColor="{StaticResource PrimaryDarkText}"
                                   Opacity="0.8"
                                   LineHeight="1.3" />
                        </StackLayout>
                    </Grid>

                </Border>

                <!-- Progress Indicator - Complete -->
                <StackLayout Spacing="12" HorizontalOptions="Center" Margin="0,24,0,0">
                    <Label Text="{Binding ProgressText}"
                           Style="{StaticResource CaptionStyle}"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Success}"
                           HorizontalTextAlignment="Center" />

                    <!-- Progress Dots - All Complete -->
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" HorizontalOptions="Center">

                        <!-- All dots completed -->
                        <Ellipse Grid.Column="0"
                                 WidthRequest="10" HeightRequest="10"
                                 Fill="{StaticResource Success}" />

                        <Ellipse Grid.Column="1"
                                 WidthRequest="10" HeightRequest="10"
                                 Fill="{StaticResource Success}" />

                        <Ellipse Grid.Column="2"
                                 WidthRequest="10" HeightRequest="10"
                                 Fill="{StaticResource Success}" />

                        <Ellipse Grid.Column="3"
                                 WidthRequest="10" HeightRequest="10"
                                 Fill="{StaticResource Success}" />

                        <Ellipse Grid.Column="4"
                                 WidthRequest="10" HeightRequest="10"
                                 Fill="{StaticResource Success}" />

                        <Ellipse Grid.Column="5"
                                 WidthRequest="10" HeightRequest="10"
                                 Fill="{StaticResource Success}" />

                    </Grid>
                </StackLayout>

                <!-- Espaçamento para bottom navigation -->
                <BoxView HeightRequest="80" BackgroundColor="Transparent" />

            </StackLayout>
        </ScrollView>

        <!-- Navigation Section -->
        <Border Grid.Row="2"
                BackgroundColor="{StaticResource Background}"
                Padding="24,16,24,32">

            <Border.Shadow>
                <Shadow Brush="#40000000" Offset="0,-4" Radius="16" Opacity="0.1" />
            </Border.Shadow>

            <!-- Final Action Button -->
            <Border WidthRequest="240" HeightRequest="56"
                    BackgroundColor="{StaticResource Success}"
                    StrokeShape="RoundRectangle 16"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">

                <Border.Shadow>
                    <Shadow Brush="{StaticResource Success}" Offset="0,6" Radius="24" Opacity="0.35" />
                </Border.Shadow>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NextPageCommand}"/>
                </Border.GestureRecognizers>

                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center" HorizontalOptions="Center">
                    <Label Grid.Column="0"
                           Text="rocket_launch"
                           FontFamily="MaterialIcons"
                           FontSize="24"
                           TextColor="White"
                           VerticalOptions="Center"
                           HorizontalOptions="Center" />

                    <StackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center" HorizontalOptions="Center">
                        <Label Text="{Binding GetStartedButton}"
                               Style="{StaticResource TitleStyle}"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalTextAlignment="Center"
                               VerticalOptions="Center" />
                        <Label Text="{Binding AccessOrionVault}"
                               Style="{StaticResource CaptionStyle}"
                               FontSize="12"
                               TextColor="White"
                               Opacity="0.9"
                               HorizontalTextAlignment="Center"
                               VerticalOptions="Center" />
                    </StackLayout>

                    <Label Grid.Column="2"
                           Text="arrow_forward"
                           FontFamily="MaterialIcons"
                           FontSize="18"
                           TextColor="White"
                           VerticalOptions="Center"
                           HorizontalOptions="Center" />
                </Grid>
            </Border>

        </Border>

    </Grid>
</ContentPage>
