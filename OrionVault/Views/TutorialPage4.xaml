<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:OrionVault.ViewModels"
             x:Class="OrionVault.Views.TutorialPage4"
             x:DataType="viewModels:TutorialPage4ViewModel"
             Shell.NavBarIsVisible="False"
             Title="TutorialPage4">

    <Grid RowDefinitions="*,*,Auto">

        <!-- Hero Section -->
        <StackLayout Grid.Row="0" 
                     Spacing="32" 
                     VerticalOptions="Center"
                     Padding="24,60,24,24">

            <!-- Information Icon with Glow -->
            <Border WidthRequest="120" HeightRequest="120"
                    BackgroundColor="{StaticResource Info}"
                    StrokeShape="RoundRectangle 32"
                    HorizontalOptions="Center">

                <Border.Shadow>
                    <Shadow Brush="{StaticResource Info}" Offset="0,16" Radius="48" Opacity="0.4" />
                </Border.Shadow>

                <Grid>
                    <!-- Information rings -->
                    <Ellipse WidthRequest="90" HeightRequest="90"
                             Stroke="{StaticResource Info}"
                             StrokeThickness="2"
                             Fill="Transparent"
                             Opacity="0.2"
                             HorizontalOptions="Center"
                             VerticalOptions="Center" />

                    <Ellipse WidthRequest="70" HeightRequest="70"
                             Stroke="{StaticResource Info}"
                             StrokeThickness="2"
                             Fill="Transparent"
                             Opacity="0.4"
                             HorizontalOptions="Center"
                             VerticalOptions="Center" />

                    <Ellipse WidthRequest="50" HeightRequest="50"
                             Fill="#40FFFFFF"
                             HorizontalOptions="Center"
                             VerticalOptions="Center" />

                    <Label Text="info"
                           FontFamily="MaterialIcons"
                           FontSize="48"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Grid>

            </Border>

            <!-- Title -->
            <Label Text="{Binding Title}"
                   Style="{StaticResource HeadlineStyle}"
                   FontSize="36"
                   TextColor="{StaticResource Primary}"
                   HorizontalTextAlignment="Center"
                   LineHeight="1.2">

                <Label.Shadow>
                    <Shadow Brush="{StaticResource Primary}" Offset="0,2" Radius="8" Opacity="0.2" />
                </Label.Shadow>

            </Label>

        </StackLayout>

        <!-- Content Section -->
        <ScrollView Grid.Row="1" Padding="24">
            <StackLayout Spacing="28" VerticalOptions="Center">

                <!-- Main Description Card -->
                <Border Style="{StaticResource ElevatedCardStyle}"
                        MaximumWidthRequest="420"
                        HorizontalOptions="Center">

                    <StackLayout Spacing="24">

                        <!-- Privacy Header -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                            <Border Grid.Column="0"
                                    WidthRequest="40" HeightRequest="40"
                                    BackgroundColor="{StaticResource Info}"
                                    StrokeShape="RoundRectangle 12">

                                <Label Text="privacy_tip"
                                       FontFamily="MaterialIcons"
                                       FontSize="20"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <StackLayout Grid.Column="1" Spacing="4">
                                <Label Text="{Binding PrivacyCommitmentTitle}"
                                       Style="{StaticResource TitleStyle}"
                                       FontSize="18"
                                       TextColor="{StaticResource Info}" />

                                <Label Text="{Binding YourDataIsYours}"
                                       Style="{StaticResource CaptionStyle}"
                                       Opacity="0.8" />
                            </StackLayout>
                        </Grid>

                        <!-- Main Description -->
                        <Label Text="{Binding Description}"
                               Style="{StaticResource BodyStyle}"
                               FontSize="16"
                               HorizontalTextAlignment="Center"
                               LineHeight="1.6" />

                    </StackLayout>
                </Border>

                <!-- Privacy Features Grid -->
                <Grid RowDefinitions="Auto,Auto" 
                      ColumnDefinitions="*,*" 
                      RowSpacing="16" 
                      ColumnSpacing="16"
                      MaximumWidthRequest="400"
                      HorizontalOptions="Center">

                    <!-- Local Storage -->
                    <Border Grid.Row="0" Grid.Column="0"
                            Style="{StaticResource CardStyle}"
                            BackgroundColor="{StaticResource ElevatedSurface}"
                            Padding="20,16">

                        <StackLayout Spacing="12" HorizontalOptions="Center">
                            <Label Text="storage"
                                   FontFamily="MaterialIcons"
                                   FontSize="32"
                                   TextColor="{StaticResource Primary}"
                                   HorizontalOptions="Center" />

                            <Label Text="{Binding Local}"
                                   Style="{StaticResource CaptionStyle}"
                                   FontAttributes="Bold"
                                   FontSize="14"
                                   HorizontalTextAlignment="Center" />

                            <Label Text="{Binding StoredOnDevice}"
                                   Style="{StaticResource CaptionStyle}"
                                   FontSize="11"
                                   HorizontalTextAlignment="Center"
                                   LineHeight="1.3"
                                   Opacity="0.8" />
                        </StackLayout>
                    </Border>

                    <!-- No Cloud -->
                    <Border Grid.Row="0" Grid.Column="1"
                            Style="{StaticResource CardStyle}"
                            BackgroundColor="{StaticResource ElevatedSurface}"
                            Padding="20,16">

                        <StackLayout Spacing="12" HorizontalOptions="Center">
                            <Label Text="cloud_off"
                                   FontFamily="MaterialIcons"
                                   FontSize="32"
                                   TextColor="{StaticResource Warning}"
                                   HorizontalOptions="Center" />

                            <Label Text="{Binding NoCloud}"
                                   Style="{StaticResource CaptionStyle}"
                                   FontAttributes="Bold"
                                   FontSize="14"
                                   HorizontalTextAlignment="Center" />

                            <Label Text="{Binding NoDataToServer}"
                                   Style="{StaticResource CaptionStyle}"
                                   FontSize="11"
                                   HorizontalTextAlignment="Center"
                                   LineHeight="1.3"
                                   Opacity="0.8" />
                        </StackLayout>
                    </Border>

                    <!-- No Tracking -->
                    <Border Grid.Row="1" Grid.Column="0"
                            Style="{StaticResource CardStyle}"
                            BackgroundColor="{StaticResource ElevatedSurface}"
                            Padding="20,16">

                        <StackLayout Spacing="12" HorizontalOptions="Center">
                            <Label Text="block"
                                   FontFamily="MaterialIcons"
                                   FontSize="32"
                                   TextColor="{StaticResource Error}"
                                   HorizontalOptions="Center" />

                            <Label Text="{Binding NoTracking}"
                                   Style="{StaticResource CaptionStyle}"
                                   FontAttributes="Bold"
                                   FontSize="14"
                                   HorizontalTextAlignment="Center" />

                            <Label Text="{Binding NoPersonalInfo}"
                                   Style="{StaticResource CaptionStyle}"
                                   FontSize="11"
                                   HorizontalTextAlignment="Center"
                                   LineHeight="1.3"
                                   Opacity="0.8" />
                        </StackLayout>
                    </Border>

                    <!-- Open Source -->
                    <Border Grid.Row="1" Grid.Column="1"
                            Style="{StaticResource CardStyle}"
                            BackgroundColor="{StaticResource ElevatedSurface}"
                            Padding="20,16">

                        <StackLayout Spacing="12" HorizontalOptions="Center">
                            <Label Text="code"
                                   FontFamily="MaterialIcons"
                                   FontSize="32"
                                   TextColor="{StaticResource Success}"
                                   HorizontalOptions="Center" />

                            <Label Text="{Binding Transparent}"
                                   Style="{StaticResource CaptionStyle}"
                                   FontAttributes="Bold"
                                   FontSize="14"
                                   HorizontalTextAlignment="Center" />

                            <Label Text="{Binding AuditableCode}"
                                   Style="{StaticResource CaptionStyle}"
                                   FontSize="11"
                                   HorizontalTextAlignment="Center"
                                   LineHeight="1.3"
                                   Opacity="0.8" />
                        </StackLayout>
                    </Border>

                </Grid>

                <!-- Trust Badge -->
                <Border Style="{StaticResource CardStyle}"
                        BackgroundColor="{StaticResource Success}"
                        MaximumWidthRequest="300"
                        HorizontalOptions="Center"
                        Padding="20,16">

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <Label Grid.Column="0"
                               Text="verified"
                               FontFamily="MaterialIcons"
                               FontSize="28"
                               TextColor="White"
                               VerticalOptions="Center" />

                        <StackLayout Grid.Column="1" Spacing="4">
                            <Label Text="{Binding Private100}"
                                   Style="{StaticResource TitleStyle}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="White" />

                            <Label Text="{Binding PrivacyFocused}"
                                   Style="{StaticResource CaptionStyle}"
                                   FontSize="12"
                                   TextColor="White"
                                   Opacity="0.9"
                                   LineHeight="1.3" />
                        </StackLayout>
                    </Grid>

                </Border>

            </StackLayout>
        </ScrollView>

        <!-- Navigation Section -->
        <StackLayout Grid.Row="2" 
                     Spacing="24" 
                     Padding="24,0,24,60"
                     VerticalOptions="End">

            <!-- Progress Indicator -->
            <StackLayout Spacing="12" HorizontalOptions="Center">
                <Label Text="{Binding ProgressText}"
                       Style="{StaticResource CaptionStyle}"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Primary}"
                       HorizontalTextAlignment="Center" />

                <!-- Progress Dots -->
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" HorizontalOptions="Center">

                    <!-- Dot 1 - Completed -->
                    <Ellipse Grid.Column="0"
                             WidthRequest="8" HeightRequest="8"
                             Fill="{StaticResource Success}"
                             Opacity="0.7" />

                    <!-- Dot 2 - Completed -->
                    <Ellipse Grid.Column="1"
                             WidthRequest="8" HeightRequest="8"
                             Fill="{StaticResource Success}"
                             Opacity="0.7" />

                    <!-- Dot 3 - Completed -->
                    <Ellipse Grid.Column="2"
                             WidthRequest="8" HeightRequest="8"
                             Fill="{StaticResource Success}"
                             Opacity="0.7" />

                    <!-- Dot 4 - Active -->
                    <Ellipse Grid.Column="3"
                             WidthRequest="12" HeightRequest="12"
                             Fill="{StaticResource Primary}" />

                    <!-- Dot 5 -->
                    <Ellipse Grid.Column="4"
                             WidthRequest="8" HeightRequest="8"
                             Fill="{StaticResource TextTertiary}"
                             Opacity="0.5" />

                    <!-- Dot 6 -->
                    <Ellipse Grid.Column="5"
                             WidthRequest="8" HeightRequest="8"
                             Fill="{StaticResource TextTertiary}"
                             Opacity="0.5" />

                </Grid>
            </StackLayout>

            <!-- Action Buttons -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">

                <!-- Next Button -->
                <Border Grid.Column="2"
                        WidthRequest="120" HeightRequest="56"
                        BackgroundColor="{StaticResource Primary}"
                        StrokeShape="RoundRectangle 16">

                    <Border.Shadow>
                        <Shadow Brush="{StaticResource Primary}" Offset="0,6" Radius="20" Opacity="0.35" />
                    </Border.Shadow>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NextPageCommand}"/>
                    </Border.GestureRecognizers>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalOptions="Center" HorizontalOptions="Center">
                        <Label Grid.Column="0"
                               Text="{Binding NextButtonText}"
                               Style="{StaticResource CaptionStyle}"
                               FontAttributes="Bold"
                               FontSize="16"
                               TextColor="{StaticResource PrimaryDarkText}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />

                        <Label Grid.Column="1"
                               Text="arrow_forward"
                               FontFamily="MaterialIcons"
                               FontSize="20"
                               TextColor="{StaticResource PrimaryDarkText}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />
                    </Grid>

                </Border>

            </Grid>

        </StackLayout>

    </Grid>
</ContentPage>
