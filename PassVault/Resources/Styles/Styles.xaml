<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ================================ -->
    <!-- MODERN CARD STYLES -->
    <!-- ================================ -->

    <!-- Base Card Style - Modernizado -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource CardBackground}" />
        <Setter Property="Stroke" Value="{StaticResource BorderPrimary}" />
        <Setter Property="StrokeThickness" Value="0.5" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Shadow">
            <Shadow Brush="#40000000" Offset="0,8" Radius="32" Opacity="0.12" />
        </Setter>
    </Style>

    <!-- Elevated Card - Premium feel -->
    <Style x:Key="ElevatedCardStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource ElevatedSurface}" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 24" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="Shadow">
            <Shadow Brush="#50000000" Offset="0,16" Radius="48" Opacity="0.15" />
        </Setter>
    </Style>

    <!-- Floating Card - Para modais e overlays -->
    <Style x:Key="FloatingCardStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource ElevatedSurface}" />
        <Setter Property="Stroke" Value="{StaticResource BorderPrimary}" />
        <Setter Property="StrokeThickness" Value="0.5" />
        <Setter Property="StrokeShape" Value="RoundRectangle 28" />
        <Setter Property="Padding" Value="28" />
        <Setter Property="Shadow">
            <Shadow Brush="#60000000" Offset="0,24" Radius="64" Opacity="0.2" />
        </Setter>
    </Style>

    <!-- ================================ -->
    <!-- MODERN BUTTON STYLES -->
    <!-- ================================ -->

    <!-- Primary Button - Hero style -->
    <Style x:Key="ModernButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="TextColor" Value="{StaticResource PrimaryDarkText}" />
        <Setter Property="FontFamily" Value="Nunito" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="Padding" Value="20,16" />
        <Setter Property="MinimumHeightRequest" Value="56" />
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource Primary}" Offset="0,8" Radius="24" Opacity="0.3" />
        </Setter>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="1.0" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryDark}" />
                            <Setter Property="Scale" Value="0.96" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{StaticResource TextTertiary}" />
                            <Setter Property="BackgroundColor" Value="{StaticResource Gray600}" />
                            <Setter Property="Opacity" Value="0.6" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Secondary Button Style -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource ElevatedSurface}" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontFamily" Value="Nunito" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="BorderColor" Value="{StaticResource BorderPrimary}" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="Padding" Value="20,16" />
        <Setter Property="MinimumHeightRequest" Value="56" />
        <Setter Property="Shadow">
            <Shadow Brush="#30000000" Offset="0,4" Radius="16" Opacity="0.1" />
        </Setter>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource SurfaceBackground}" />
                            <Setter Property="Scale" Value="0.98" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Icon Button - Refined -->
    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="TextColor" Value="{StaticResource PrimaryDarkText}" />
        <Setter Property="FontFamily" Value="MaterialIcons" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="WidthRequest" Value="56" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource Primary}" Offset="0,6" Radius="20" Opacity="0.25" />
        </Setter>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="1.0" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryDark}" />
                            <Setter Property="Scale" Value="0.94" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Ghost Icon Button -->
    <Style x:Key="GhostIconButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource ElevatedSurface}" />
        <Setter Property="TextColor" Value="{StaticResource Primary}" />
        <Setter Property="FontFamily" Value="MaterialIcons" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="BorderColor" Value="{StaticResource BorderPrimary}" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="WidthRequest" Value="48" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="Shadow">
            <Shadow Brush="#20000000" Offset="0,2" Radius="8" Opacity="0.08" />
        </Setter>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource SurfaceBackground}" />
                            <Setter Property="Scale" Value="0.96" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- ================================ -->
    <!-- MODERN INPUT STYLES -->
    <!-- ================================ -->

    <!-- Modern Entry Style -->
    <Style x:Key="ModernEntryStyle" TargetType="Entry">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="Nunito" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextTertiary}" />
        <Setter Property="MinimumHeightRequest" Value="24" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{StaticResource Primary}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Entry Container - Glassmorphism effect -->
    <Style x:Key="EntryContainerStyle" TargetType="Border">
        <Setter Property="Stroke" Value="{StaticResource BorderPrimary}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceBackground}" />
        <Setter Property="Padding" Value="20,16" />
        <Setter Property="MinimumHeightRequest" Value="56" />
        <Setter Property="Shadow">
            <Shadow Brush="#15000000" Offset="0,2" Radius="8" Opacity="0.05" />
        </Setter>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="Stroke" Value="{StaticResource Primary}" />
                            <Setter Property="StrokeThickness" Value="2" />
                            <Setter Property="BackgroundColor" Value="{StaticResource ElevatedSurface}" />
                            <Setter Property="Shadow">
                                <Shadow Brush="{StaticResource Primary}" Offset="0,4" Radius="16" Opacity="0.1" />
                            </Setter>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- ================================ -->
    <!-- MODERN NAVIGATION STYLES -->
    <!-- ================================ -->

    <!-- Navigation Menu - Floating with glassmorphism -->
    <Style x:Key="NavigationMenuStyle" TargetType="Border">
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#80312D38" Offset="0.0" />
                <GradientStop Color="#A019171C" Offset="1.0" />
            </LinearGradientBrush>
        </Setter>
        <Setter Property="Stroke" Value="{StaticResource BorderPrimary}" />
        <Setter Property="StrokeThickness" Value="0.5" />
        <Setter Property="StrokeShape" Value="RoundRectangle 32" />
        <Setter Property="Padding" Value="20,16" />
        <Setter Property="Shadow">
            <Shadow Brush="#80000000" Offset="0,16" Radius="48" Opacity="0.25" />
        </Setter>
    </Style>

    <!-- ================================ -->
    <!-- MODERN LIST ITEM STYLES -->
    <!-- ================================ -->

    <!-- List Item - Enhanced interaction -->
    <Style x:Key="ListItemStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource CardBackground}" />
        <Setter Property="Stroke" Value="{StaticResource BorderPrimary}" />
        <Setter Property="StrokeThickness" Value="0.5" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="Shadow">
            <Shadow Brush="#25000000" Offset="0,4" Radius="16" Opacity="0.08" />
        </Setter>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="1.0" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource ElevatedSurface}" />
                            <Setter Property="Scale" Value="0.98" />
                            <Setter Property="Shadow">
                                <Shadow Brush="#40000000" Offset="0,8" Radius="24" Opacity="0.12" />
                            </Setter>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Premium List Item -->
    <Style x:Key="PremiumListItemStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource ElevatedSurface}" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="Margin" Value="0,6" />
        <Setter Property="Shadow">
            <Shadow Brush="#35000000" Offset="0,8" Radius="32" Opacity="0.1" />
        </Setter>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource CardBackground}" />
                            <Setter Property="Scale" Value="0.99" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- ================================ -->
    <!-- ENHANCED TEXT STYLES -->
    <!-- ================================ -->

    <!-- Display Text - Extra large -->
    <Style x:Key="DisplayStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="LineHeight" Value="1.2" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <!-- Headline - Main titles -->
    <Style x:Key="HeadlineStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="LineHeight" Value="1.25" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <!-- Title - Section headers -->
    <Style x:Key="TitleStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="LineHeight" Value="1.3" />
    </Style>

    <!-- Subtitle -->
    <Style x:Key="SubtitleStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="LineHeight" Value="1.4" />
    </Style>

    <!-- Body Text -->
    <Style x:Key="BodyStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineHeight" Value="1.5" />
    </Style>

    <!-- Caption Text -->
    <Style x:Key="CaptionStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextTertiary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="1.4" />
    </Style>

    <!-- Overline Text -->
    <Style x:Key="OverlineStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Primary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="1.5" />
    </Style>

    <!-- ================================ -->
    <!-- DEFAULT OVERRIDES -->
    <!-- ================================ -->

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource Primary}" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource PrimaryDarkText}" />
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="FontFamily" Value="Nunito"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="BorderWidth" Value="0"/>
        <Setter Property="CornerRadius" Value="28"/>
        <Setter Property="Padding" Value="20,16"/>
        <Setter Property="MinimumHeightRequest" Value="56"/>
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource Primary}" Offset="0,8" Radius="24" Opacity="0.3" />
        </Setter>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{StaticResource TextTertiary}" />
                            <Setter Property="BackgroundColor" Value="{StaticResource Gray600}" />
                            <Setter Property="Opacity" Value="0.6" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryDark}" />
                            <Setter Property="Scale" Value="0.96" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="Nunito"/>
        <Setter Property="FontSize" Value="16" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextTertiary}" />
        <Setter Property="MinimumHeightRequest" Value="24"/>
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="Nunito" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineHeight" Value="1.5" />
    </Style>

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BackgroundColor" Value="{StaticResource Background}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{StaticResource SurfaceBackground}" />
        <Setter Property="Shell.ForegroundColor" Value="{StaticResource Primary}" />
        <Setter Property="Shell.TitleColor" Value="{StaticResource Primary}" />
        <Setter Property="Shell.DisabledColor" Value="{StaticResource TextTertiary}" />
        <Setter Property="Shell.UnselectedColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource SurfaceBackground}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource Primary}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{StaticResource Primary}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource TextSecondary}" />
    </Style>

    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor" Value="{StaticResource SurfaceBackground}" />
        <Setter Property="BarTextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="IconColor" Value="{StaticResource Primary}" />
    </Style>

</ResourceDictionary>