<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:OrionVault.ViewModels"
             x:Class="OrionVault.Views.TutorialPage3"
             x:DataType="viewModels:TutorialPage3ViewModel"
             Shell.NavBarIsVisible="False"
             Title="TutorialPage3">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Hero Section -->
        <StackLayout Grid.Row="0" 
                     Spacing="20" 
                     Padding="24,60,24,16">

            <!-- Biometric Icon -->
            <Border WidthRequest="80" HeightRequest="80"
                    BackgroundColor="{StaticResource Warning}"
                    StrokeShape="RoundRectangle 24"
                    HorizontalOptions="Center">

                <Border.Shadow>
                    <Shadow Brush="{StaticResource Warning}" Offset="0,8" Radius="24" Opacity="0.3" />
                </Border.Shadow>

                <Label Text="fingerprint"
                       FontFamily="MaterialIcons"
                       FontSize="36"
                       TextColor="White"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />

            </Border>

            <!-- Title -->
            <Label Text="{Binding Title}"
                   Style="{StaticResource HeadlineStyle}"
                   FontSize="24"
                   TextColor="{StaticResource Primary}"
                   HorizontalTextAlignment="Center"
                   LineHeight="1.2" />

        </StackLayout>

        <!-- Content Section with ScrollView -->
        <ScrollView Grid.Row="1" Padding="24,0,24,0">
            <StackLayout Spacing="24">

                <!-- Description -->
                <Label Text="{Binding Description}"
                       Style="{StaticResource BodyStyle}"
                       FontSize="16"
                       HorizontalTextAlignment="Center"
                       LineHeight="1.5"
                       Margin="0,0,0,16" />

                <!-- Authentication Methods -->
                <StackLayout Spacing="12">

                    <!-- Fingerprint -->
                    <Border Style="{StaticResource CardStyle}"
                            BackgroundColor="{StaticResource ElevatedSurface}"
                            Padding="16,12">

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Grid.Column="0"
                                   Text="fingerprint"
                                   FontFamily="MaterialIcons"
                                   FontSize="20"
                                   TextColor="{StaticResource Warning}"
                                   VerticalOptions="Center" />

                            <StackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{Binding Fingerprint}"
                                       Style="{StaticResource CaptionStyle}"
                                       FontAttributes="Bold"
                                       FontSize="14" />

                                <Label Text="{Binding UnlockWithFinger}"
                                       Style="{StaticResource CaptionStyle}"
                                       FontSize="12"
                                       Opacity="0.7" />
                            </StackLayout>
                        </Grid>
                    </Border>

                    <!-- Face ID -->
                    <Border Style="{StaticResource CardStyle}"
                            BackgroundColor="{StaticResource ElevatedSurface}"
                            Padding="16,12">

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Grid.Column="0"
                                   Text="face"
                                   FontFamily="MaterialIcons"
                                   FontSize="20"
                                   TextColor="{StaticResource Info}"
                                   VerticalOptions="Center" />

                            <StackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{Binding FaceId}"
                                       Style="{StaticResource CaptionStyle}"
                                       FontAttributes="Bold"
                                       FontSize="14" />

                                <Label Text="{Binding UnlockWithFace}"
                                       Style="{StaticResource CaptionStyle}"
                                       FontSize="12"
                                       Opacity="0.7" />
                            </StackLayout>
                        </Grid>
                    </Border>

                    <!-- PIN/Pattern -->
                    <Border Style="{StaticResource CardStyle}"
                            BackgroundColor="{StaticResource ElevatedSurface}"
                            Padding="16,12">

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Grid.Column="0"
                                   Text="pattern"
                                   FontFamily="MaterialIcons"
                                   FontSize="20"
                                   TextColor="{StaticResource Primary}"
                                   VerticalOptions="Center" />

                            <StackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{Binding PinOrPattern}"
                                       Style="{StaticResource CaptionStyle}"
                                       FontAttributes="Bold"
                                       FontSize="14" />

                                <Label Text="{Binding DefaultDevicePassword}"
                                       Style="{StaticResource CaptionStyle}"
                                       FontSize="12"
                                       Opacity="0.7" />
                            </StackLayout>
                        </Grid>
                    </Border>

                </StackLayout>

                <!-- Authorization Button -->
                <Border BackgroundColor="{StaticResource Warning}"
                        StrokeShape="RoundRectangle 16"
                        Padding="20,16"
                        Margin="0,24,0,16"
                        HorizontalOptions="Center"
                        MinimumWidthRequest="280">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NextPageCommand}" />
                    </Border.GestureRecognizers>

                    <Border.Shadow>
                        <Shadow Brush="{StaticResource Warning}" Offset="0,6" Radius="20" Opacity="0.3" />
                    </Border.Shadow>

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                        <Label Grid.Column="0"
                               Text="fingerprint"
                               FontFamily="MaterialIcons"
                               FontSize="24"
                               TextColor="White"
                               VerticalOptions="Center" />

                        <StackLayout Grid.Column="1" Spacing="4">
                            <Label Text="{Binding AuthorizeAccess}"
                                   Style="{StaticResource TitleStyle}"
                                   FontSize="16"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center" />

                            <Label Text="{Binding TapToSetup}"
                                   Style="{StaticResource CaptionStyle}"
                                   FontSize="12"
                                   TextColor="White"
                                   Opacity="0.9"
                                   HorizontalTextAlignment="Center" />
                        </StackLayout>

                        <Label Grid.Column="2"
                               Text="arrow_forward"
                               FontFamily="MaterialIcons"
                               FontSize="20"
                               TextColor="White"
                               VerticalOptions="Center" />

                    </Grid>
                </Border>

                <!-- Info Note -->
                <Border BackgroundColor="{StaticResource ElevatedSurface}"
                        StrokeShape="RoundRectangle 12"
                        Padding="16,12"
                        HorizontalOptions="Center"
                        MaximumWidthRequest="300">

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Grid.Column="0"
                               Text="info"
                               FontFamily="MaterialIcons"
                               FontSize="16"
                               TextColor="{StaticResource Info}"
                               VerticalOptions="Center" />

                        <Label Grid.Column="1"
                               Text="{Binding RequiredStepMessage}"
                               Style="{StaticResource CaptionStyle}"
                               FontSize="12"
                               VerticalOptions="Center"
                               LineHeight="1.3" />
                    </Grid>
                </Border>

                <!-- Progress Indicator -->
                <StackLayout Spacing="12" HorizontalOptions="Center" Margin="0,24,0,0">
                    <Label Text="{Binding ProgressText}"
                           Style="{StaticResource CaptionStyle}"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           HorizontalTextAlignment="Center" />

                    <!-- Progress Dots -->
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" HorizontalOptions="Center">

                        <!-- Dot 1 - Completed -->
                        <Ellipse Grid.Column="0"
                                 WidthRequest="8" HeightRequest="8"
                                 Fill="{StaticResource Success}"
                                 Opacity="0.7" />

                        <!-- Dot 2 - Completed -->
                        <Ellipse Grid.Column="1"
                                 WidthRequest="8" HeightRequest="8"
                                 Fill="{StaticResource Success}"
                                 Opacity="0.7" />

                        <!-- Dot 3 - Active -->
                        <Ellipse Grid.Column="2"
                                 WidthRequest="12" HeightRequest="12"
                                 Fill="{StaticResource Primary}" />

                        <!-- Dot 4 -->
                        <Ellipse Grid.Column="3"
                                 WidthRequest="8" HeightRequest="8"
                                 Fill="{StaticResource TextTertiary}"
                                 Opacity="0.5" />

                        <!-- Dot 5 -->
                        <Ellipse Grid.Column="4"
                                 WidthRequest="8" HeightRequest="8"
                                 Fill="{StaticResource TextTertiary}"
                                 Opacity="0.5" />

                        <!-- Dot 6 -->
                        <Ellipse Grid.Column="5"
                                 WidthRequest="8" HeightRequest="8"
                                 Fill="{StaticResource TextTertiary}"
                                 Opacity="0.5" />

                    </Grid>
                </StackLayout>

                <!-- Espaçamento para bottom navigation -->
                <BoxView HeightRequest="80" BackgroundColor="Transparent" />

            </StackLayout>
        </ScrollView>

        <!-- Navigation Section -->
        <Border Grid.Row="2"
                BackgroundColor="{StaticResource Background}"
                Padding="24,16,24,32">

            <Border.Shadow>
                <Shadow Brush="#40000000" Offset="0,-4" Radius="16" Opacity="0.1" />
            </Border.Shadow>

            <!-- Action Buttons -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">

                <!-- Continue Note -->
                <Label Grid.Column="2"
                       Text="{Binding ConfigureAbove}"
                       Style="{StaticResource CaptionStyle}"
                       FontSize="12"
                       TextColor="{StaticResource Warning}"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />

            </Grid>
        </Border>

    </Grid>
</ContentPage>
