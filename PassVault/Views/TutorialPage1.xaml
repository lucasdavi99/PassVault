<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:PassVault.ViewModels"
             x:Class="PassVault.Views.TutorialPage1"
             x:DataType="viewModels:TutorialPage1ViewModel"
             Shell.NavBarIsVisible="False"
             Title="TutorialPage1">

    <Grid RowDefinitions="*,*,Auto">

        <!-- Hero Section -->
        <StackLayout Grid.Row="0" 
                     Spacing="24" 
                     VerticalOptions="Center"
                     Padding="24,60,24,24">

            <!-- App Logo/Icon -->
            <Border WidthRequest="120" HeightRequest="120"
                    BackgroundColor="{StaticResource ElevatedSurface}"
                    StrokeShape="RoundRectangle 32"
                    HorizontalOptions="Center">

                <Border.Shadow>
                    <Shadow Brush="{StaticResource Primary}" Offset="0,16" Radius="48" Opacity="0.4" />
                </Border.Shadow>

                <Grid>
                    <!-- App SVG Logo -->
                    <Image Source="logo.png"
                           WidthRequest="80"
                           HeightRequest="80"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Grid>

            </Border>

            <!-- Welcome Title -->
            <StackLayout Spacing="16" HorizontalOptions="Center">
                <Label Text="{Binding Title}"
                       Style="{StaticResource HeadlineStyle}"
                       FontSize="32"
                       TextColor="{StaticResource TextSecondary}"
                       HorizontalTextAlignment="Center" />

                <Label Text="PassVault"
                       Style="{StaticResource DisplayStyle}"
                       FontSize="48"
                       TextColor="{StaticResource Primary}"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center">

                    <Label.Shadow>
                        <Shadow Brush="{StaticResource Primary}" Offset="0,4" Radius="16" Opacity="0.3" />
                    </Label.Shadow>

                </Label>
            </StackLayout>

        </StackLayout>

        <!-- Content Section -->
        <StackLayout Grid.Row="1" 
                     Spacing="32" 
                     VerticalOptions="Center"
                     Padding="24">

            <!-- Description Card -->
            <Border Style="{StaticResource ElevatedCardStyle}"
                    MaximumWidthRequest="400"
                    HorizontalOptions="Center">

                <StackLayout Spacing="20">

                    <!-- Icon Header -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <Border Grid.Column="0"
                                WidthRequest="40" HeightRequest="40"
                                BackgroundColor="{StaticResource Info}"
                                StrokeShape="RoundRectangle 12">

                            <Label Text="info"
                                   FontFamily="MaterialIcons"
                                   FontSize="20"
                                   TextColor="White"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <StackLayout Grid.Column="1" Spacing="4">
                            <Label Text="{Binding PageTitle}"
                                   Style="{StaticResource TitleStyle}"
                                   FontSize="18"
                                   TextColor="{StaticResource Primary}" />

                            <Label Text="{Binding PageSubtitle}"
                                   Style="{StaticResource CaptionStyle}"
                                   Opacity="0.8" />
                        </StackLayout>
                    </Grid>

                    <!-- Main Description -->
                    <Label Text="{Binding Description}"
                           Style="{StaticResource BodyStyle}"
                           FontSize="18"
                           HorizontalTextAlignment="Center"
                           LineHeight="1.5"
                           Opacity="0.9" />

                    <!-- Features Preview -->
                    <StackLayout Spacing="12">

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Grid.Column="0"
                                   Text="check_circle"
                                   FontFamily="MaterialIcons"
                                   FontSize="18"
                                   TextColor="{StaticResource Success}"
                                   VerticalOptions="Center" />

                            <Label Text="{Binding CreateAndOrganizeText}"
                                   Style="{StaticResource CaptionStyle}"
                                   FontSize="14"
                                   VerticalOptions="Center" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Grid.Column="0"
                                   Text="check_circle"
                                   FontFamily="MaterialIcons"
                                   FontSize="18"
                                   TextColor="{StaticResource Success}"
                                   VerticalOptions="Center" />

                            <Label Text="{Binding SecureStorageText}"
                                   Style="{StaticResource CaptionStyle}"
                                   FontSize="14"
                                   VerticalOptions="Center" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Grid.Column="0"
                                   Text="check_circle"
                                   FontFamily="MaterialIcons"
                                   FontSize="18"
                                   TextColor="{StaticResource Success}"
                                   VerticalOptions="Center" />

                            <Label Text="{Binding PasswordGeneratorText}"
                                   Style="{StaticResource CaptionStyle}"
                                   FontSize="14"
                                   VerticalOptions="Center" />
                        </Grid>

                    </StackLayout>

                </StackLayout>
            </Border>

        </StackLayout>

        <!-- Navigation Section -->
        <StackLayout Grid.Row="2" 
                     Spacing="24" 
                     Padding="24,0,24,60"
                     VerticalOptions="End">

            <!-- Progress Indicator -->
            <StackLayout Spacing="12" HorizontalOptions="Center">
                <Label Text="{Binding ProgressText}"
                       Style="{StaticResource CaptionStyle}"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Primary}"
                       HorizontalTextAlignment="Center" />

                <!-- Progress Dots -->
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" HorizontalOptions="Center">

                    <!-- Dot 1 - Active -->
                    <Ellipse Grid.Column="0"
                             WidthRequest="12" HeightRequest="12"
                             Fill="{StaticResource Primary}" />

                    <!-- Dot 2 -->
                    <Ellipse Grid.Column="1"
                             WidthRequest="8" HeightRequest="8"
                             Fill="{StaticResource TextTertiary}"
                             Opacity="0.5" />

                    <!-- Dot 3 -->
                    <Ellipse Grid.Column="2"
                             WidthRequest="8" HeightRequest="8"
                             Fill="{StaticResource TextTertiary}"
                             Opacity="0.5" />

                    <!-- Dot 4 -->
                    <Ellipse Grid.Column="3"
                             WidthRequest="8" HeightRequest="8"
                             Fill="{StaticResource TextTertiary}"
                             Opacity="0.5" />

                    <!-- Dot 5 -->
                    <Ellipse Grid.Column="4"
                             WidthRequest="8" HeightRequest="8"
                             Fill="{StaticResource TextTertiary}"
                             Opacity="0.5" />

                </Grid>
            </StackLayout>

            <!-- Action Buttons -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">

                <!-- Next Button -->
                <Border Grid.Column="1"
                        WidthRequest="120" HeightRequest="56"
                        BackgroundColor="{StaticResource Primary}"
                        StrokeShape="RoundRectangle 16">

                    <Border.Shadow>
                        <Shadow Brush="{StaticResource Primary}" Offset="0,6" Radius="20" Opacity="0.35" />
                    </Border.Shadow>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NextPageCommand}"/>
                    </Border.GestureRecognizers>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0"
                               Text="{Binding NextButtonText}"
                               Style="{StaticResource CaptionStyle}"
                               FontAttributes="Bold"
                               FontSize="16"
                               TextColor="{StaticResource PrimaryDarkText}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />

                        <Label Grid.Column="1"
                               Text="arrow_forward"
                               FontFamily="MaterialIcons"
                               FontSize="20"
                               TextColor="{StaticResource PrimaryDarkText}"
                               VerticalOptions="Center" />
                    </Grid>

                </Border>

            </Grid>

        </StackLayout>

    </Grid>
</ContentPage>