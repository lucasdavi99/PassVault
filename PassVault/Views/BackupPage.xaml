<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:PassVault.ViewModels"
             x:DataType="viewModels:BackupViewModel"
             x:Class="PassVault.Views.BackupPage"
             Title="Backup">

    <ScrollView>
        <StackLayout Padding="24" Spacing="24">

            <!-- Header -->
            <StackLayout Spacing="8" Margin="0,20,0,16">
                <Label Text="Backup e Restore"
                       Style="{StaticResource HeadlineStyle}"
                       TextColor="{StaticResource Primary}" />

                <Label Text="Mantenha suas senhas seguras em qualquer lugar"
                       Style="{StaticResource BodyStyle}"
                       HorizontalTextAlignment="Center" />
            </StackLayout>

            <!-- Export Section -->
            <Border Style="{StaticResource ElevatedCardStyle}">
                <StackLayout Spacing="20">

                    <!-- Export Header -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Grid.Column="0"
                                WidthRequest="40" HeightRequest="40"
                                BackgroundColor="{StaticResource Primary}"
                                StrokeShape="RoundRectangle 12">

                            <Label Text="cloud_upload"
                                   FontFamily="MaterialIcons"
                                   FontSize="20"
                                   TextColor="{StaticResource PrimaryDarkText}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <StackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Exportar Backup"
                                   Style="{StaticResource TitleStyle}"
                                   FontSize="20" />

                            <Label Text="Crie um backup criptografado dos seus dados"
                                   Style="{StaticResource CaptionStyle}" />
                        </StackLayout>
                    </Grid>

                    <!-- Export Password Display -->
                    <Border IsVisible="{Binding IsPasswordVisible}"
                            Style="{StaticResource EntryContainerStyle}"
                            BackgroundColor="{StaticResource ElevatedSurface}">

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="16,12">

                            <Label Grid.Column="0"
                                   Text="key"
                                   FontFamily="MaterialIcons"
                                   FontSize="20"
                                   TextColor="{StaticResource Primary}"
                                   VerticalOptions="Center" />

                            <StackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Senha de Exportação"
                                       Style="{StaticResource CaptionStyle}"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}" />

                                <Label Text="{Binding ExportPassword}"
                                       Style="{StaticResource BodyStyle}"
                                       FontFamily="Courier"
                                       FontAttributes="Bold"
                                       FontSize="16" />
                            </StackLayout>

                            <Button Grid.Column="2"
                                    Text="content_copy"
                                    FontFamily="MaterialIcons"
                                    Style="{StaticResource IconButtonStyle}"
                                    WidthRequest="36" HeightRequest="36"
                                    FontSize="16" />
                        </Grid>
                    </Border>

                    <!-- Export Button -->
                    <Button Text="Exportar Backup"
                            Style="{StaticResource ModernButtonStyle}"
                            Command="{Binding ExportBackupCommand}">

                        <Button.ImageSource>
                            <FontImageSource FontFamily="MaterialIcons"
                                             Glyph="backup"
                                             Color="{StaticResource PrimaryDarkText}"
                                             Size="20" />
                        </Button.ImageSource>

                    </Button>

                </StackLayout>
            </Border>

            <!-- Divider -->
            <BoxView HeightRequest="1" 
                     BackgroundColor="{StaticResource Divider}"
                     Margin="20,0" />

            <!-- Import Section -->
            <Border Style="{StaticResource ElevatedCardStyle}">
                <StackLayout Spacing="20">

                    <!-- Import Header -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Grid.Column="0"
                                WidthRequest="40" HeightRequest="40"
                                BackgroundColor="{StaticResource Info}"
                                StrokeShape="RoundRectangle 12">

                            <Label Text="cloud_download"
                                   FontFamily="MaterialIcons"
                                   FontSize="20"
                                   TextColor="White"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <StackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Importar Backup"
                                   Style="{StaticResource TitleStyle}"
                                   FontSize="20" />

                            <Label Text="Restaure seus dados a partir de um backup existente"
                                   Style="{StaticResource CaptionStyle}" />
                        </StackLayout>
                    </Grid>

                    <!-- Import Button -->
                    <Button Text="Importar Backup"
                            BackgroundColor="{StaticResource Info}"
                            TextColor="White"
                            Style="{StaticResource ModernButtonStyle}"
                            Command="{Binding ImportBackupCommand}">

                        <Button.ImageSource>
                            <FontImageSource FontFamily="MaterialIcons"
                                             Glyph="restore"
                                             Color="White"
                                             Size="20" />
                        </Button.ImageSource>

                    </Button>

                </StackLayout>
            </Border>

            <!-- Security Info -->
            <Border Style="{StaticResource CardStyle}"
                    Stroke="{StaticResource Info}"
                    BackgroundColor="{StaticResource ElevatedSurface}">

                <StackLayout Spacing="16">

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Grid.Column="0"
                               Text="info"
                               FontFamily="MaterialIcons"
                               FontSize="24"
                               TextColor="{StaticResource Info}"
                               VerticalOptions="Start" />

                        <StackLayout Grid.Column="1" Spacing="8">
                            <Label Text="Informações de Segurança"
                                   Style="{StaticResource TitleStyle}"
                                   FontSize="16"
                                   TextColor="{StaticResource Info}" />

                            <Label Text="• Os backups são criptografados com AES-256"
                                   Style="{StaticResource CaptionStyle}" />

                            <Label Text="• Apenas a senha de exportação pode descriptografar os dados"
                                   Style="{StaticResource CaptionStyle}" />

                            <Label Text="• Backups expiram automaticamente em 24 horas"
                                   Style="{StaticResource CaptionStyle}" />

                            <Label Text="• Guarde sua senha em local seguro"
                                   Style="{StaticResource CaptionStyle}"
                                   FontAttributes="Bold" />
                        </StackLayout>
                    </Grid>

                </StackLayout>
            </Border>

            <!-- Bottom Spacing -->
            <BoxView HeightRequest="20" BackgroundColor="Transparent" />

        </StackLayout>
    </ScrollView>
</ContentPage>