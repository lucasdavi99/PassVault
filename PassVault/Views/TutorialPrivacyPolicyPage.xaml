<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:PassVault.ViewModels"
             x:Class="PassVault.Views.TutorialPrivacyPolicyPage"
             x:DataType="viewModels:TutorialPrivacyPolicyPageViewModel"
             Shell.NavBarIsVisible="False"
             Title="TutorialPrivacyPolicyPage">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Hero Section -->
        <StackLayout Grid.Row="0"
                     Spacing="24"
                     Padding="24,60,24,24"
                     VerticalOptions="Center">

            <Border WidthRequest="120" HeightRequest="120"
                    BackgroundColor="{StaticResource Warning}"
                    StrokeShape="RoundRectangle 32"
                    HorizontalOptions="Center">

                <Border.Shadow>
                    <Shadow Brush="{StaticResource Warning}" Offset="0,16" Radius="48" Opacity="0.35" />
                </Border.Shadow>

                <Grid>
                    <Ellipse WidthRequest="90" HeightRequest="90"
                             Stroke="{StaticResource Warning}"
                             StrokeThickness="2"
                             Fill="Transparent"
                             Opacity="0.2"
                             HorizontalOptions="Center"
                             VerticalOptions="Center" />

                    <Ellipse WidthRequest="60" HeightRequest="60"
                             Fill="#40FFFFFF"
                             HorizontalOptions="Center"
                             VerticalOptions="Center" />

                    <Label Text="gavel"
                           FontFamily="MaterialIcons"
                           FontSize="44"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Grid>
            </Border>

            <Label Text="{Binding Title}"
                   Style="{StaticResource HeadlineStyle}"
                   FontSize="32"
                   TextColor="{StaticResource Primary}"
                   HorizontalTextAlignment="Center"
                   LineHeight="1.2">
                <Label.Shadow>
                    <Shadow Brush="{StaticResource Primary}" Offset="0,2" Radius="8" Opacity="0.2" />
                </Label.Shadow>
            </Label>
        </StackLayout>

        <!-- Content Section -->
        <ScrollView Grid.Row="1" Padding="24">
            <StackLayout Spacing="20">

                <Border Style="{StaticResource ElevatedCardStyle}"
                        MaximumWidthRequest="420"
                        HorizontalOptions="Center">
                    <StackLayout Spacing="12">
                        <Label Text="{Binding Intro}"
                               Style="{StaticResource BodyStyle}"
                               FontSize="16"
                               LineHeight="1.5"
                               HorizontalTextAlignment="Center" />
                    </StackLayout>
                </Border>

                <Border Style="{StaticResource ElevatedCardStyle}">
                    <StackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Grid.Column="0"
                                   Text="verified_user"
                                   FontFamily="MaterialIcons"
                                   FontSize="22"
                                   TextColor="{StaticResource Success}"
                                   VerticalOptions="Center" />
                            <StackLayout Grid.Column="1" Spacing="4">
                                <Label Text="{Binding AcceptanceTitle}"
                                       Style="{StaticResource TitleStyle}"
                                       FontSize="18"
                                       TextColor="{StaticResource Primary}" />
                                <Label Text="{Binding AcceptanceDescription}"
                                       Style="{StaticResource CaptionStyle}"
                                       FontSize="14"
                                       LineHeight="1.4" />
                            </StackLayout>
                        </Grid>
                    </StackLayout>
                </Border>

                <Border Style="{StaticResource ElevatedCardStyle}">
                    <StackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Grid.Column="0"
                                   Text="security"
                                   FontFamily="MaterialIcons"
                                   FontSize="22"
                                   TextColor="{StaticResource Info}"
                                   VerticalOptions="Center" />
                            <StackLayout Grid.Column="1" Spacing="4">
                                <Label Text="{Binding ResponsibleUseTitle}"
                                       Style="{StaticResource TitleStyle}"
                                       FontSize="18"
                                       TextColor="{StaticResource Primary}" />
                                <Label Text="{Binding ResponsibleUseDescription}"
                                       Style="{StaticResource CaptionStyle}"
                                       FontSize="14"
                                       LineHeight="1.4" />
                            </StackLayout>
                        </Grid>
                    </StackLayout>
                </Border>

                <Border Style="{StaticResource ElevatedCardStyle}">
                    <StackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Grid.Column="0"
                                   Text="lock"
                                   FontFamily="MaterialIcons"
                                   FontSize="22"
                                   TextColor="{StaticResource Primary}"
                                   VerticalOptions="Center" />
                            <StackLayout Grid.Column="1" Spacing="4">
                                <Label Text="{Binding SecurityTitle}"
                                       Style="{StaticResource TitleStyle}"
                                       FontSize="18"
                                       TextColor="{StaticResource Primary}" />
                                <Label Text="{Binding SecurityDescription}"
                                       Style="{StaticResource CaptionStyle}"
                                       FontSize="14"
                                       LineHeight="1.4" />
                            </StackLayout>
                        </Grid>
                    </StackLayout>
                </Border>

                <Border Style="{StaticResource ElevatedCardStyle}">
                    <StackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Grid.Column="0"
                                   Text="balance"
                                   FontFamily="MaterialIcons"
                                   FontSize="22"
                                   TextColor="{StaticResource Warning}"
                                   VerticalOptions="Center" />
                            <StackLayout Grid.Column="1" Spacing="4">
                                <Label Text="{Binding LiabilityTitle}"
                                       Style="{StaticResource TitleStyle}"
                                       FontSize="18"
                                       TextColor="{StaticResource Primary}" />
                                <Label Text="{Binding LiabilityDescription}"
                                       Style="{StaticResource CaptionStyle}"
                                       FontSize="14"
                                       LineHeight="1.4" />
                            </StackLayout>
                        </Grid>
                    </StackLayout>
                </Border>

                <Border Style="{StaticResource ElevatedCardStyle}">
                    <StackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Grid.Column="0"
                                   Text="update"
                                   FontFamily="MaterialIcons"
                                   FontSize="22"
                                   TextColor="{StaticResource Info}"
                                   VerticalOptions="Center" />
                            <StackLayout Grid.Column="1" Spacing="4">
                                <Label Text="{Binding UpdatesTitle}"
                                       Style="{StaticResource TitleStyle}"
                                       FontSize="18"
                                       TextColor="{StaticResource Primary}" />
                                <Label Text="{Binding UpdatesDescription}"
                                       Style="{StaticResource CaptionStyle}"
                                       FontSize="14"
                                       LineHeight="1.4" />
                            </StackLayout>
                        </Grid>
                    </StackLayout>
                </Border>

            </StackLayout>
        </ScrollView>

        <!-- Navigation Section -->
        <StackLayout Grid.Row="2"
                     Spacing="24"
                     Padding="24,0,24,60">

            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="12"
                  Padding="0,0,0,8">
                <CheckBox Grid.Column="0"
                          IsChecked="{Binding IsPolicyAccepted}"
                          HorizontalOptions="Center"
                          VerticalOptions="Center"
                          Color="{StaticResource Primary}" />

                <Label Grid.Column="1"
                       Text="{Binding AcknowledgementText}"
                       Style="{StaticResource CaptionStyle}"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextSecondary}"
                       LineHeight="1.4" />
            </Grid>

            <!-- Progress Indicator -->
            <StackLayout Spacing="12" HorizontalOptions="Center">
                <Label Text="{Binding ProgressText}"
                       Style="{StaticResource CaptionStyle}"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Primary}"
                       HorizontalTextAlignment="Center" />

                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                      ColumnSpacing="8"
                      HorizontalOptions="Center">

                    <Ellipse Grid.Column="0"
                             WidthRequest="8" HeightRequest="8"
                             Fill="{StaticResource Success}"
                             Opacity="0.7" />

                    <Ellipse Grid.Column="1"
                             WidthRequest="8" HeightRequest="8"
                             Fill="{StaticResource Success}"
                             Opacity="0.7" />

                    <Ellipse Grid.Column="2"
                             WidthRequest="8" HeightRequest="8"
                             Fill="{StaticResource Success}"
                             Opacity="0.7" />

                    <Ellipse Grid.Column="3"
                             WidthRequest="8" HeightRequest="8"
                             Fill="{StaticResource Success}"
                             Opacity="0.7" />

                    <Ellipse Grid.Column="4"
                             WidthRequest="12" HeightRequest="12"
                             Fill="{StaticResource Primary}" />

                    <Ellipse Grid.Column="5"
                             WidthRequest="8" HeightRequest="8"
                             Fill="{StaticResource TextTertiary}"
                             Opacity="0.5" />
                </Grid>
            </StackLayout>

            <Border WidthRequest="160" HeightRequest="56"
                    BackgroundColor="{StaticResource Primary}"
                    StrokeShape="RoundRectangle 16"
                    HorizontalOptions="Center">

                <Border.Shadow>
                    <Shadow Brush="{StaticResource Primary}" Offset="0,6" Radius="20" Opacity="0.35" />
                </Border.Shadow>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ContinueCommand}" />
                </Border.GestureRecognizers>

                <Grid HorizontalOptions="Center"
                      VerticalOptions="Center"
                      ColumnDefinitions="Auto,Auto"
                      ColumnSpacing="12">
                    <Label Grid.Column="0"
                           Text="{Binding NextButtonText}"
                           Style="{StaticResource CaptionStyle}"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="{StaticResource PrimaryDarkText}"
                           VerticalOptions="Center"
                           HorizontalOptions="Center" />

                    <Label Grid.Column="1"
                           Text="arrow_forward"
                           FontFamily="MaterialIcons"
                           FontSize="20"
                           TextColor="{StaticResource PrimaryDarkText}"
                           VerticalOptions="Center"
                           HorizontalOptions="Center" />
                </Grid>
            </Border>
        </StackLayout>
    </Grid>
</ContentPage>
