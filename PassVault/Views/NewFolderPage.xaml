<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:PassVault.ViewModels"
             x:DataType="viewmodel:NewFolderPageViewModel"
             xmlns:controls="clr-namespace:Maui.ColorPicker;assembly=Maui.ColorPicker"
             x:Class="PassVault.Views.NewFolderPage"
             Title="Nova Pasta">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Modern Header -->
        <Border Grid.Row="0" 
                Background="{StaticResource SurfaceGradient}"
                Padding="0,50,0,32"
                StrokeShape="RoundRectangle 0,0,28,28">

            <StackLayout Spacing="12">

                <!-- Title with Icon -->
                <Grid ColumnDefinitions="Auto,*" 
                      ColumnSpacing="16"
                      HorizontalOptions="Center">

                    <Border Grid.Column="0"
                            WidthRequest="48" HeightRequest="48"
                            BackgroundColor="{StaticResource Primary}"
                            StrokeShape="RoundRectangle 16">

                        <Border.Shadow>
                            <Shadow Brush="{StaticResource Primary}" Offset="0,4" Radius="12" Opacity="0.3" />
                        </Border.Shadow>

                        <Label Text="create_new_folder"
                               FontFamily="MaterialIcons"
                               FontSize="24"
                               TextColor="{StaticResource PrimaryDarkText}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <StackLayout Grid.Column="1" 
                                 VerticalOptions="Center"
                                 Spacing="4">

                        <Label Text="Nova Pasta"
                               Style="{StaticResource HeadlineStyle}"
                               FontSize="24"
                               TextColor="{StaticResource Primary}"
                               HorizontalTextAlignment="Start" />

                        <Label Text="Organize suas contas criando uma pasta"
                               Style="{StaticResource CaptionStyle}"
                               HorizontalTextAlignment="Start"
                               Opacity="0.8" />
                    </StackLayout>
                </Grid>

            </StackLayout>
        </Border>

        <!-- Main Content -->
        <ScrollView Grid.Row="1">
            <StackLayout Spacing="32" Padding="24,32,24,120">

                <!-- Folder Preview Card -->
                <Border Style="{StaticResource ElevatedCardStyle}">
                    <StackLayout Spacing="24" HorizontalOptions="Center">

                        <!-- Preview Header -->
                        <StackLayout Spacing="8">
                            <Label Text="Prévia da Pasta"
                                   Style="{StaticResource TitleStyle}"
                                   FontSize="18"
                                   TextColor="{StaticResource Primary}"
                                   HorizontalTextAlignment="Center" />

                            <Label Text="Veja como sua pasta ficará"
                                   Style="{StaticResource CaptionStyle}"
                                   HorizontalTextAlignment="Center"
                                   Opacity="0.8" />
                        </StackLayout>

                        <!-- Folder Icon Preview -->
                        <Border WidthRequest="120" HeightRequest="120"
                                Background="{Binding SelectedColor}"
                                StrokeShape="RoundRectangle 24"
                                StrokeThickness="2"
                                Stroke="{StaticResource BorderPrimary}">

                            <Border.Shadow>
                                <Shadow Brush="{Binding SelectedColor}" Offset="0,12" Radius="32" Opacity="0.4" />
                            </Border.Shadow>

                            <Grid>
                                <!-- Background for better contrast -->
                                <Ellipse WidthRequest="48" HeightRequest="48"
                                         Fill="#30FFFFFF"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center" />

                                <Label Text="folder"
                                       FontFamily="MaterialIcons"
                                       FontSize="64"
                                       TextColor="{StaticResource PrimaryDarkText}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Grid>

                        </Border>

                        <!-- Folder Name Preview -->
                        <Border BackgroundColor="{StaticResource SurfaceBackground}"
                                StrokeShape="RoundRectangle 12"
                                Padding="16,8"
                                MinimumWidthRequest="200">

                            <Label Text="{Binding Title, TargetNullValue='Nome da Pasta'}"
                                   Style="{StaticResource TitleStyle}"
                                   FontSize="16"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{StaticResource TextPrimary}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding Title}" Value="">
                                        <Setter Property="Text" Value="Nome da Pasta" />
                                        <Setter Property="TextColor" Value="{StaticResource TextTertiary}" />
                                        <Setter Property="FontAttributes" Value="Italic" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding Title}" Value="{x:Null}">
                                        <Setter Property="Text" Value="Nome da Pasta" />
                                        <Setter Property="TextColor" Value="{StaticResource TextTertiary}" />
                                        <Setter Property="FontAttributes" Value="Italic" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>

                    </StackLayout>
                </Border>

                <!-- Form Card -->
                <Border Style="{StaticResource ElevatedCardStyle}">
                    <StackLayout Spacing="28">

                        <!-- Form Header -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Grid.Column="0"
                                   Text="edit"
                                   FontFamily="MaterialIcons"
                                   FontSize="20"
                                   TextColor="{StaticResource Primary}"
                                   VerticalOptions="Center" />

                            <StackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Informações da Pasta"
                                       Style="{StaticResource TitleStyle}"
                                       FontSize="16"
                                       TextColor="{StaticResource Primary}" />

                                <Label Text="Defina nome e cor da pasta"
                                       Style="{StaticResource CaptionStyle}"
                                       Opacity="0.8" />
                            </StackLayout>
                        </Grid>

                        <!-- Title Field -->
                        <StackLayout Spacing="12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="title"
                                       FontFamily="MaterialIcons"
                                       FontSize="16"
                                       TextColor="{StaticResource Primary}"
                                       VerticalOptions="Center" />

                                <Label Grid.Column="1"
                                       Text="Nome da Pasta *"
                                       Style="{StaticResource CaptionStyle}"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}"
                                       VerticalOptions="Center" />
                            </Grid>

                            <Border Style="{StaticResource EntryContainerStyle}">
                                <Entry Placeholder="Ex: Trabalho, Pessoal, Redes Sociais..."
                                       Style="{StaticResource ModernEntryStyle}"
                                       Text="{Binding Title, Mode=TwoWay}"
                                       FontSize="18" />
                            </Border>
                        </StackLayout>

                        <!-- Color Selection -->
                        <StackLayout Spacing="16">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="palette"
                                       FontFamily="MaterialIcons"
                                       FontSize="16"
                                       TextColor="{StaticResource Primary}"
                                       VerticalOptions="Center" />

                                <Label Grid.Column="1"
                                       Text="Cor de Identificação"
                                       Style="{StaticResource CaptionStyle}"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}"
                                       VerticalOptions="Center" />
                            </Grid>

                            <!-- Current Color Display -->
                            <Border WidthRequest="80" HeightRequest="80"
                                    Background="{Binding SelectedColor}"
                                    StrokeShape="RoundRectangle 20"
                                    StrokeThickness="2"
                                    Stroke="{StaticResource BorderPrimary}"
                                    HorizontalOptions="Center">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleColorPickerCommand}" />
                                </Border.GestureRecognizers>

                                <Border.Shadow>
                                    <Shadow Brush="{Binding SelectedColor}" Offset="0,8" Radius="20" Opacity="0.4" />
                                </Border.Shadow>

                                <Grid>
                                    <Ellipse WidthRequest="32" HeightRequest="32"
                                             Fill="#40FFFFFF"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center" />

                                    <Label Text="palette"
                                           FontFamily="MaterialIcons"
                                           FontSize="20"
                                           TextColor="{StaticResource PrimaryDarkText}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Grid>

                            </Border>

                            <!-- Color Selection Info -->
                            <Label Text="Toque no círculo para escolher uma cor personalizada"
                                   Style="{StaticResource CaptionStyle}"
                                   HorizontalTextAlignment="Center"
                                   Opacity="0.7" />

                        </StackLayout>

                    </StackLayout>
                </Border>

            </StackLayout>
        </ScrollView>

        <!-- Fixed Action Buttons -->
        <Border Grid.Row="2"
                VerticalOptions="End"
                HorizontalOptions="FillAndExpand"
                BackgroundColor="{StaticResource Background}"
                Padding="24,16,24,32">

            <Border.Shadow>
                <Shadow Brush="#40000000" Offset="0,-4" Radius="16" Opacity="0.1" />
            </Border.Shadow>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
               
                <!-- Create Button -->
                <Button Grid.Column="1"
                        Text="Criar Pasta"
                        Style="{StaticResource ModernButtonStyle}"
                        Command="{Binding SaveFolderCommand}">

                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialIcons"
                                         Glyph="create_new_folder"
                                         Color="{StaticResource PrimaryDarkText}"
                                         Size="18" />
                    </Button.ImageSource>

                </Button>

            </Grid>
        </Border>

        <!-- Color Picker Modal -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              IsVisible="{Binding IsColorPickerVisible}"
              BackgroundColor="#80000000">

            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseColorPickerCommand}" />
            </Grid.GestureRecognizers>

            <!-- Color Picker Card -->
            <Border Style="{StaticResource FloatingCardStyle}"
                    MaximumWidthRequest="380"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Margin="24">

                <StackLayout Spacing="24">

                    <!-- Modal Header -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Cor Personalizada"
                                   Style="{StaticResource TitleStyle}"
                                   FontSize="20"
                                   TextColor="{StaticResource Primary}" />

                            <Label Text="Escolha uma cor única para sua pasta"
                                   Style="{StaticResource CaptionStyle}"
                                   Opacity="0.8" />
                        </StackLayout>

                        <Border Grid.Column="1"
                                WidthRequest="32" HeightRequest="32"
                                BackgroundColor="{StaticResource SurfaceBackground}"
                                StrokeShape="RoundRectangle 10">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CloseColorPickerCommand}" />
                            </Border.GestureRecognizers>

                            <Label Text="close"
                                   FontFamily="MaterialIcons"
                                   FontSize="16"
                                   TextColor="{StaticResource TextTertiary}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <!-- Color Picker -->
                    <controls:ColorPicker x:Name="ColorPicker"
                                          ColorFlowDirection="Horizontal"
                                          WidthRequest="320"
                                          HeightRequest="200"
                                          ColorSpectrumStyle="ShadeToHueToTintStyle"
                                          PointerRingBorderUnits="0.3"
                                          PointerRingDiameterUnits="0.7"
                                          HorizontalOptions="Center"
                                          PickedColor="{Binding SelectedColor, Mode=TwoWay}" />

                    <!-- Hex Input -->
                    <StackLayout Spacing="8">
                        <Label Text="Código Hexadecimal"
                               Style="{StaticResource CaptionStyle}"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextSecondary}" />

                        <Border Style="{StaticResource EntryContainerStyle}">
                            <Entry Placeholder="#FF5733"
                                   Text="{Binding SelectedColorHex, Mode=TwoWay}"
                                   Style="{StaticResource ModernEntryStyle}"
                                   Keyboard="Text"
                                   HorizontalTextAlignment="Center" />
                        </Border>
                    </StackLayout>

                    <!-- Confirm Button -->
                    <Button Text="Confirmar Cor"
                            Style="{StaticResource ModernButtonStyle}"
                            Command="{Binding CloseColorPickerCommand}">

                        <Button.ImageSource>
                            <FontImageSource FontFamily="MaterialIcons"
                                             Glyph="check"
                                             Color="{StaticResource PrimaryDarkText}"
                                             Size="18" />
                        </Button.ImageSource>

                    </Button>

                </StackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>