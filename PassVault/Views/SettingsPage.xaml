<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:PassVault.ViewModels"
             x:DataType="viewModels:SettingsPageViewModel"
             x:Class="PassVault.Views.SettingsPage"
             Title="{Binding SettingsTitle}">

    <Grid RowDefinitions="Auto,*">

        <!-- Modern Header -->
        <Border Grid.Row="0" 
                Background="{StaticResource SurfaceGradient}"
                Padding="0,50,0,32"
                StrokeShape="RoundRectangle 0,0,28,28">

            <StackLayout Spacing="12">

                <!-- Title with Icon -->
                <Grid ColumnDefinitions="Auto,*" 
                      ColumnSpacing="16"
                      HorizontalOptions="Center">

                    <Border Grid.Column="0"
                            WidthRequest="48" HeightRequest="48"
                            BackgroundColor="{StaticResource Primary}"
                            StrokeShape="RoundRectangle 16">

                        <Border.Shadow>
                            <Shadow Brush="{StaticResource Primary}" Offset="0,4" Radius="12" Opacity="0.3" />
                        </Border.Shadow>

                        <Label Text="settings"
                               FontFamily="MaterialIcons"
                               FontSize="24"
                               TextColor="{StaticResource PrimaryDarkText}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <StackLayout Grid.Column="1" 
                                 VerticalOptions="Center"
                                 Spacing="4">

                        <Label Text="{Binding SettingsTitle}"
                               Style="{StaticResource HeadlineStyle}"
                               FontSize="24"
                               TextColor="{StaticResource Primary}"
                               HorizontalTextAlignment="Start" />

                        <Label Text="{Binding SettingsSubtitle}"
                               Style="{StaticResource CaptionStyle}"
                               HorizontalTextAlignment="Start"
                               Opacity="0.8" />
                    </StackLayout>
                </Grid>

            </StackLayout>
        </Border>

        <!-- Main Content -->
        <ScrollView Grid.Row="1">
            <StackLayout Spacing="24" Padding="24,24,24,120">

                <!-- Language Section -->
                <Border Style="{StaticResource ElevatedCardStyle}">
                    <StackLayout Spacing="20">

                        <!-- Language Header -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Grid.Column="0"
                                    WidthRequest="40" HeightRequest="40"
                                    BackgroundColor="{StaticResource Info}"
                                    StrokeShape="RoundRectangle 12">

                                <Label Text="language"
                                       FontFamily="MaterialIcons"
                                       FontSize="20"
                                       TextColor="{StaticResource PrimaryDarkText}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <StackLayout Grid.Column="1" Spacing="4">
                                <Label Text="{Binding LanguageTitle}"
                                       Style="{StaticResource TitleStyle}"
                                       FontSize="16"
                                       TextColor="{StaticResource Primary}" />

                                <Label Text="{Binding LanguageSubtitle}"
                                       Style="{StaticResource CaptionStyle}"
                                       Opacity="0.8" />
                            </StackLayout>
                        </Grid>

                        <!-- Language Selection -->
                        <StackLayout Spacing="12">
                            <Label Text="{Binding CurrentLanguageText}"
                                   Style="{StaticResource CaptionStyle}"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />

                            <Border Style="{StaticResource EntryContainerStyle}">
                                <Picker Title="Selecione o idioma"
                                        ItemsSource="{Binding AvailableLanguages}"
                                        SelectedItem="{Binding SelectedLanguage}"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource TextPrimary}" />
                            </Border>
                        </StackLayout>

                        <!-- Apply Language Button -->
                        <Button Text="{Binding ApplyLanguageText}"
                                Style="{StaticResource ModernButtonStyle}"
                                Command="{Binding ApplyLanguageCommand}">

                            <Button.ImageSource>
                                <FontImageSource FontFamily="MaterialIcons"
                                                 Glyph="check"
                                                 Color="{StaticResource PrimaryDarkText}"
                                                 Size="20" />
                            </Button.ImageSource>
                        </Button>

                    </StackLayout>
                </Border>

                <!-- Reset Section -->
                <Border Style="{StaticResource ElevatedCardStyle}">
                    <StackLayout Spacing="20">

                        <!-- Reset Header -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Grid.Column="0"
                                    WidthRequest="40" HeightRequest="40"
                                    BackgroundColor="{StaticResource Warning}"
                                    StrokeShape="RoundRectangle 12">

                                <Label Text="refresh"
                                       FontFamily="MaterialIcons"
                                       FontSize="20"
                                       TextColor="{StaticResource PrimaryDarkText}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <StackLayout Grid.Column="1" Spacing="4">
                                <Label Text="{Binding ResetTitle}"
                                       Style="{StaticResource TitleStyle}"
                                       FontSize="16"
                                       TextColor="{StaticResource Primary}" />

                                <Label Text="{Binding ResetSubtitle}"
                                       Style="{StaticResource CaptionStyle}"
                                       Opacity="0.8" />
                            </StackLayout>
                        </Grid>

                        <!-- Warning Message -->
                        <Border BackgroundColor="{StaticResource Warning}"
                                StrokeShape="RoundRectangle 12"
                                Padding="16">

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label Grid.Column="0"
                                       Text="warning"
                                       FontFamily="MaterialIcons"
                                       FontSize="20"
                                       TextColor="{StaticResource PrimaryDarkText}"
                                       VerticalOptions="Center" />

                                <StackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="{Binding WarningTitle}"
                                           Style="{StaticResource CaptionStyle}"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource PrimaryDarkText}" />

                                    <Label Text="{Binding WarningMessage}"
                                           Style="{StaticResource CaptionStyle}"
                                           FontSize="12"
                                           TextColor="{StaticResource PrimaryDarkText}"
                                           LineHeight="1.3" />
                                </StackLayout>
                            </Grid>
                        </Border>

                        <!-- Reset Button -->
                        <Button Text="{Binding ResetAppText}"
                                Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding ResetAppCommand}">

                            <Button.ImageSource>
                                <FontImageSource FontFamily="MaterialIcons"
                                                 Glyph="delete_forever"
                                                 Color="White"
                                                 Size="20" />
                            </Button.ImageSource>
                        </Button>

                    </StackLayout>
                </Border>

                <!-- About Section -->
                <Border Style="{StaticResource ElevatedCardStyle}">
                    <StackLayout Spacing="20">

                        <!-- About Header -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Grid.Column="0"
                                    WidthRequest="40" HeightRequest="40"
                                    BackgroundColor="{StaticResource Primary}"
                                    StrokeShape="RoundRectangle 12">

                                <Label Text="info"
                                       FontFamily="MaterialIcons"
                                       FontSize="20"
                                       TextColor="{StaticResource PrimaryDarkText}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <StackLayout Grid.Column="1" Spacing="4">
                                <Label Text="{Binding AboutTitle}"
                                       Style="{StaticResource TitleStyle}"
                                       FontSize="16"
                                       TextColor="{StaticResource Primary}" />

                                <Label Text="{Binding AboutSubtitle}"
                                       Style="{StaticResource CaptionStyle}"
                                       Opacity="0.8" />
                            </StackLayout>
                        </Grid>

                        <!-- App Info -->
                        <StackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Label Grid.Column="0"
                                       Text="{Binding VersionText}"
                                       Style="{StaticResource CaptionStyle}"
                                       VerticalOptions="Center" />

                                <Label Grid.Column="1"
                                       Text="{Binding AppVersion}"
                                       Style="{StaticResource CaptionStyle}"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}"
                                       VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" 
                                     BackgroundColor="{StaticResource Divider}" />

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Label Grid.Column="0"
                                       Text="{Binding DeveloperText}"
                                       Style="{StaticResource CaptionStyle}"
                                       VerticalOptions="Center" />

                                <Label Grid.Column="1"
                                       Text="Cuboide Studio"
                                       Style="{StaticResource CaptionStyle}"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </StackLayout>

                    </StackLayout>
                </Border>

            </StackLayout>
        </ScrollView>

    </Grid>

</ContentPage>