<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:PassVault.ViewModels"
             xmlns:converters="clr-namespace:PassVault.Converters"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:models="clr-namespace:PassVault.Models"
             x:Class="PassVault.Views.MainPage"
             x:DataType="viewModels:MainPageViewModel"
             Shell.NavBarIsVisible="False"
             Title="MainPage">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:TabVisibilityConverter x:Key="TabVisibilityConverter" />
            <converters:HexToColorConverter x:Key="HexToColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header com gradiente sutil -->
        <Border Grid.Row="0" 
                Background="{StaticResource SurfaceGradient}"
                Padding="0,40,0,16">

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">

                <!-- Tab Buttons -->
                <Label Grid.Column="0" Grid.Row="0"
                       Text="Itens"
                       Style="{StaticResource TitleStyle}"
                       HorizontalTextAlignment="Center"
                       TextColor="{Binding SelectedTab, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=Itens, TargetNullValue=White, FallbackValue=White}"
                       Opacity="{Binding SelectedTab, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=Itens, TargetNullValue=0.6, FallbackValue=0.6}">

                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="Itens"/>
                    </Label.GestureRecognizers>

                </Label>

                <Label Grid.Column="1" Grid.Row="0"
                       Text="Pastas"
                       Style="{StaticResource TitleStyle}"
                       HorizontalTextAlignment="Center"
                       TextColor="{Binding SelectedTab, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=Pastas, TargetNullValue=White, FallbackValue=White}"
                       Opacity="{Binding SelectedTab, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=Pastas, TargetNullValue=0.6, FallbackValue=0.6}">

                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="Pastas"/>
                    </Label.GestureRecognizers>

                </Label>

                <!-- Tab Indicators com animação -->
                <Border Grid.Column="0" Grid.Row="1"
                        WidthRequest="60"
                        HeightRequest="3"
                        BackgroundColor="{StaticResource Primary}"
                        HorizontalOptions="Center"
                        VerticalOptions="End"
                        StrokeShape="RoundRectangle 2"
                        Margin="0,12,0,0"
                        IsVisible="{Binding SelectedTab, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=Itens}">

                    <Border.Shadow>
                        <Shadow Brush="{StaticResource Black}" Offset="0,2" Radius="6" Opacity="0.3" />
                    </Border.Shadow>

                </Border>

                <Border Grid.Column="1" Grid.Row="1"
                        WidthRequest="60"
                        HeightRequest="3"
                        BackgroundColor="{StaticResource Primary}"
                        HorizontalOptions="Center"
                        VerticalOptions="End"
                        StrokeShape="RoundRectangle 2"
                        Margin="0,12,0,0"
                        IsVisible="{Binding SelectedTab, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=Pastas}">

                    <Border.Shadow>
                        <Shadow Brush="{StaticResource Black}" Offset="0,2" Radius="6" Opacity="0.3" />
                    </Border.Shadow>

                </Border>

            </Grid>
        </Border>

        <!-- Conteúdo com scroll suave -->
        <ScrollView Grid.Row="1" Padding="16,8,16,24">
            <Grid>

                <!-- Tab Itens -->
                <StackLayout IsVisible="{Binding SelectedTab, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=Itens}" Spacing="8">

                    <CollectionView ItemsSource="{Binding Accounts}">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="8"/>
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Account">
                                <SwipeView>
                                    <SwipeView.RightItems>
                                        <SwipeItems>
                                            <SwipeItem Text="Excluir"
                                                       BackgroundColor="{StaticResource Error}"
                                                       Command="{Binding x:DataType='viewModels:MainPageViewModel',Source={RelativeSource AncestorType={x:Type viewModels:MainPageViewModel}}, Path=DeleteAccountCommand}"
                                                       CommandParameter="{Binding .}" />
                                        </SwipeItems>
                                    </SwipeView.RightItems>

                                    <Border Style="{StaticResource ListItemStyle}"
                                            MinimumWidthRequest="300"
                                            MaximumWidthRequest="400">

                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding x:DataType='viewModels:MainPageViewModel',Source={RelativeSource AncestorType={x:Type viewModels:MainPageViewModel}}, Path=EditAccountCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>

                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">

                                            <!-- Ícone colorido -->
                                            <Border WidthRequest="40" HeightRequest="40"
                                                    BackgroundColor="{Binding Color, Converter={StaticResource HexToColorConverter}}"
                                                    StrokeShape="RoundRectangle 12"
                                                    Grid.Column="0"
                                                    VerticalOptions="Center">

                                                <Label Text="key"
                                                       FontFamily="MaterialIcons"
                                                       FontSize="20"
                                                       TextColor="{StaticResource PrimaryDarkText}"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />

                                            </Border>

                                            <!-- Conteúdo -->
                                            <StackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">

                                                <Label Text="{Binding Title}"
                                                       Style="{StaticResource TitleStyle}"
                                                       FontSize="18" />

                                                <Label Text="{Binding Created, StringFormat='Criado em {0:dd/MM/yyyy}'}"
                                                       Style="{StaticResource CaptionStyle}" />

                                            </StackLayout>

                                            <!-- Indicador de acesso -->
                                            <Label Text="chevron_right"
                                                   FontFamily="MaterialIcons"
                                                   FontSize="20"
                                                   TextColor="{StaticResource TextTertiary}"
                                                   Grid.Column="2"
                                                   VerticalOptions="Center" />

                                        </Grid>
                                    </Border>
                                </SwipeView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>

                <!-- Tab Pastas -->
                <StackLayout IsVisible="{Binding SelectedTab, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=Pastas}" Spacing="8">

                    <CollectionView ItemsSource="{Binding Folders}">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="8"/>
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Folder">
                                <SwipeView>
                                    <SwipeView.RightItems>
                                        <SwipeItems>
                                            <SwipeItem Text="Excluir"
                                                       BackgroundColor="{StaticResource Error}"
                                                       Command="{Binding x:DataType='viewModels:MainPageViewModel',Source={RelativeSource AncestorType={x:Type viewModels:MainPageViewModel}}, Path=DeleteFolderCommand}"
                                                       CommandParameter="{Binding .}" />
                                        </SwipeItems>
                                    </SwipeView.RightItems>

                                    <Border Style="{StaticResource ListItemStyle}"
                                            MinimumWidthRequest="300"
                                            MaximumWidthRequest="400">

                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding x:DataType='viewModels:MainPageViewModel', Source={RelativeSource AncestorType={x:Type viewModels:MainPageViewModel}}, Path=OpenFolderCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>

                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">

                                            <!-- Ícone de pasta -->
                                            <Border WidthRequest="40" HeightRequest="40"
                                                    BackgroundColor="{Binding Color, Converter={StaticResource HexToColorConverter}}"
                                                    StrokeShape="RoundRectangle 12"
                                                    Grid.Column="0"
                                                    VerticalOptions="Center">

                                                <Label Text="folder"
                                                       FontFamily="MaterialIcons"
                                                       FontSize="20"
                                                       TextColor="{StaticResource PrimaryDarkText}"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />

                                            </Border>

                                            <!-- Conteúdo -->
                                            <StackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">

                                                <Label Text="{Binding Title}"
                                                       Style="{StaticResource TitleStyle}"
                                                       FontSize="18" />

                                                <Label Text="Pasta de contas"
                                                       Style="{StaticResource CaptionStyle}" />

                                            </StackLayout>

                                            <!-- Indicador de acesso -->
                                            <Label Text="chevron_right"
                                                   FontFamily="MaterialIcons"
                                                   FontSize="20"
                                                   TextColor="{StaticResource TextTertiary}"
                                                   Grid.Column="2"
                                                   VerticalOptions="Center" />

                                        </Grid>
                                    </Border>
                                </SwipeView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>
            </Grid>
        </ScrollView>

        <!-- Help Button -->
        <Border Grid.Row="2"
                WidthRequest="32" HeightRequest="32"
                BackgroundColor="{StaticResource ElevatedSurface}"
                StrokeShape="RoundRectangle 16"
                Stroke="{StaticResource BorderPrimary}"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="24,0,24,120">

            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding HelpCommand}"/>
            </Border.GestureRecognizers>

            <Border.Shadow>
                <Shadow Brush="{StaticResource Black}" Offset="0,4" Radius="8" Opacity="0.2" />
            </Border.Shadow>

            <Label Text="help"
                   FontFamily="MaterialIcons"
                   FontSize="16"
                   TextColor="{StaticResource Primary}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />

        </Border>

        <!-- Floating Action Menu -->
        <Border Grid.Row="2"
                Style="{StaticResource NavigationMenuStyle}"
                WidthRequest="280"
                HeightRequest="76"
                HorizontalOptions="Center"
                VerticalOptions="End"
                Margin="0,0,0,24">

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">

                <!-- Export/Import Button -->
                <Button Grid.Column="0"
                        Style="{StaticResource IconButtonStyle}"
                        Text="cloud_download"
                        FontSize="24"
                        Command="{Binding SelectActionCommand}"
                        CommandParameter="Export/Import" />

                <!-- Add Button (Primary) -->
                <Button Grid.Column="1"
                        WidthRequest="56" HeightRequest="56"
                        CornerRadius="28"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="{StaticResource PrimaryDarkText}"
                        FontFamily="MaterialIcons"
                        FontSize="32"
                        Text="add"
                        Padding="0"
                        Command="{Binding SelectActionCommand}"
                        CommandParameter="Add">

                    <Button.Shadow>
                        <Shadow Brush="{StaticResource Black}" Offset="0,4" Radius="12" Opacity="0.25" />
                    </Button.Shadow>

                </Button>

                <!-- Search Button -->
                <Button Grid.Column="2"
                        Style="{StaticResource IconButtonStyle}"
                        Text="search"
                        FontSize="24"
                        Command="{Binding SelectActionCommand}"
                        CommandParameter="Search" />

            </Grid>
        </Border>
    </Grid>
</ContentPage>