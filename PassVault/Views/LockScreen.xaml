<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:PassVault.ViewModels"
             x:Class="PassVault.Views.LockScreen"
             x:DataType="viewModels:LockScreenViewModel"
             Shell.NavBarIsVisible="False"
             Title="LockScreen">

    <ContentPage.BindingContext>
        <viewModels:LockScreenViewModel />
    </ContentPage.BindingContext>

    <!-- Background with subtle gradient -->
    <Grid Background="{StaticResource CardGradient}">

        <!-- Main Content -->
        <StackLayout Spacing="48" VerticalOptions="Center" Padding="32">

            <!-- Welcome Title -->
            <StackLayout Spacing="16">
                <Label Text="{Binding Title}" 
                       TextColor="{StaticResource Primary}"
                       FontAttributes="Bold" 
                       FontSize="48"
                       HorizontalTextAlignment="Center">

                    <Label.Shadow>
                        <Shadow Brush="{StaticResource Black}" Offset="0,3" Radius="8" Opacity="0.3" />
                    </Label.Shadow>

                </Label>

                <Label Text="Protegendo suas senhas com segurança"
                       Style="{StaticResource BodyStyle}"
                       HorizontalTextAlignment="Center"
                       Opacity="0.8" />
            </StackLayout>

            <!-- Logo with enhanced styling -->
            <Border WidthRequest="180" HeightRequest="180"
                    BackgroundColor="{StaticResource ElevatedSurface}"
                    StrokeShape="RoundRectangle 32"
                    Stroke="{StaticResource BorderPrimary}"
                    StrokeThickness="2"
                    HorizontalOptions="Center">

                <Border.Shadow>
                    <Shadow Brush="{StaticResource Black}" Offset="0,8" Radius="24" Opacity="0.3" />
                </Border.Shadow>

                <!-- Placeholder for logo - you can replace with actual image -->
                <Grid>
                    <Ellipse WidthRequest="120" HeightRequest="120"
                             Fill="{StaticResource Primary}"
                             Opacity="0.1"
                             HorizontalOptions="Center"
                             VerticalOptions="Center" />

                    <Label Text="security"
                           FontFamily="MaterialIcons"
                           FontSize="72"
                           TextColor="{StaticResource Primary}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Grid>

            </Border>

            <!-- Security Features Info -->
            <StackLayout Spacing="12">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label Grid.Column="0"
                           Text="verified"
                           FontFamily="MaterialIcons"
                           FontSize="20"
                           TextColor="{StaticResource Primary}"
                           VerticalOptions="Center" />

                    <Label Grid.Column="1"
                           Text="Criptografia AES-256"
                           Style="{StaticResource CaptionStyle}"
                           VerticalOptions="Center" />
                </Grid>

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label Grid.Column="0"
                           Text="fingerprint"
                           FontFamily="MaterialIcons"
                           FontSize="20"
                           TextColor="{StaticResource Primary}"
                           VerticalOptions="Center" />

                    <Label Grid.Column="1"
                           Text="Autenticação biométrica"
                           Style="{StaticResource CaptionStyle}"
                           VerticalOptions="Center" />
                </Grid>

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label Grid.Column="0"
                           Text="phone_android"
                           FontFamily="MaterialIcons"
                           FontSize="20"
                           TextColor="{StaticResource Primary}"
                           VerticalOptions="Center" />

                    <Label Grid.Column="1"
                           Text="Dados armazenados localmente"
                           Style="{StaticResource CaptionStyle}"
                           VerticalOptions="Center" />
                </Grid>
            </StackLayout>

            <!-- Authentication Button -->
            <Border BackgroundColor="Transparent"
                    StrokeShape="RoundRectangle 24"
                    Stroke="{StaticResource Primary}"
                    StrokeThickness="2"
                    Padding="2">

                <Button Text="Usar senha do celular"
                        Style="{StaticResource ModernButtonStyle}"
                        WidthRequest="280"
                        HeightRequest="56"
                        FontSize="18"
                        Command="{Binding NextPageCommand}">

                    <Button.Shadow>
                        <Shadow Brush="{StaticResource Black}" Offset="0,4" Radius="12" Opacity="0.25" />
                    </Button.Shadow>

                </Button>

            </Border>

        </StackLayout>

        <!-- Subtle pattern overlay -->
        <Grid Opacity="0.03">
            <Polygon Points="0,0 100,0 0,100"
                     Fill="{StaticResource Primary}"
                     HorizontalOptions="Start"
                     VerticalOptions="Start" />

            <Polygon Points="100,100 100,0 0,100"
                     Fill="{StaticResource Primary}"
                     HorizontalOptions="End"
                     VerticalOptions="End" />
        </Grid>

    </Grid>
</ContentPage>