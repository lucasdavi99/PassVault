<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodel="clr-namespace:OrionVault.ViewModels"
    xmlns:controls="clr-namespace:Maui.ColorPicker;assembly=Maui.ColorPicker"
    x:Class="OrionVault.Views.NewAccountPage"
    x:DataType="viewmodel:NewAccountPageViewModel"
    Title="{Binding PageTitle}">

    <Grid RowDefinitions="Auto,*">

        <!-- Modern Header -->
        <Border Grid.Row="0" 
                Background="{StaticResource SurfaceGradient}"
                Padding="0,50,0,32"
                StrokeShape="RoundRectangle 0,0,28,28">

            <StackLayout Spacing="12">

                <!-- Title with Icon -->
                <Grid ColumnDefinitions="Auto,*" 
                      ColumnSpacing="16"
                      HorizontalOptions="Center">

                    <Border Grid.Column="0"
                            WidthRequest="48" HeightRequest="48"
                            BackgroundColor="{StaticResource Primary}"
                            StrokeShape="RoundRectangle 16">

                        <Border.Shadow>
                            <Shadow Brush="{StaticResource Primary}" Offset="0,4" Radius="12" Opacity="0.3" />
                        </Border.Shadow>

                        <Label Text="add_circle"
                               FontFamily="MaterialIcons"
                               FontSize="24"
                               TextColor="{StaticResource PrimaryDarkText}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <StackLayout Grid.Column="1" 
                                 VerticalOptions="Center"
                                 Spacing="4">

                        <Label Text="{Binding PageTitle}"
                               Style="{StaticResource HeadlineStyle}"
                               FontSize="24"
                               TextColor="{StaticResource Primary}"
                               HorizontalTextAlignment="Start" />

                        <Label Text="{Binding PageSubtitle}"
                               Style="{StaticResource CaptionStyle}"
                               HorizontalTextAlignment="Start"
                               Opacity="0.8" />
                    </StackLayout>
                </Grid>

            </StackLayout>
        </Border>

        <!-- Main Content -->
        <ScrollView Grid.Row="1">
            <StackLayout Spacing="28" Padding="24,24,24,120">

                <!-- Form Card -->
                <Border Style="{StaticResource ElevatedCardStyle}">
                    <StackLayout Spacing="24">

                        <!-- Title Field -->
                        <StackLayout Spacing="12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="title"
                                       FontFamily="MaterialIcons"
                                       FontSize="16"
                                       TextColor="{StaticResource Primary}"
                                       VerticalOptions="Center" />

                                <Label Grid.Column="1"
                                       Text="{Binding AccountTitleLabel}"
                                       Style="{StaticResource CaptionStyle}"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}"
                                       VerticalOptions="Center" />
                            </Grid>

                            <Border Style="{StaticResource EntryContainerStyle}">
                                <Entry Placeholder="{Binding AccountTitlePlaceholder}"
                                       Style="{StaticResource ModernEntryStyle}"
                                       Text="{Binding Title}" />
                            </Border>
                        </StackLayout>

                        <!-- Username Field -->
                        <StackLayout Spacing="12" IsVisible="{Binding IsUsernameVisible}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="person"
                                       FontFamily="MaterialIcons"
                                       FontSize="16"
                                       TextColor="{StaticResource Info}"
                                       VerticalOptions="Center" />

                                <Label Grid.Column="1"
                                       Text="{Binding UsernameLabel}"
                                       Style="{StaticResource CaptionStyle}"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextSecondary}"
                                       VerticalOptions="Center" />
                            </Grid>

                            <Border Style="{StaticResource EntryContainerStyle}">
                                <Entry Placeholder="{Binding UsernamePlaceholder}"
                                       Style="{StaticResource ModernEntryStyle}"
                                       Text="{Binding Username}" />
                            </Border>
                        </StackLayout>

                        <!-- Email Field -->
                        <StackLayout Spacing="12" IsVisible="{Binding IsEmailVisible}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="email"
                                       FontFamily="MaterialIcons"
                                       FontSize="16"
                                       TextColor="{StaticResource Warning}"
                                       VerticalOptions="Center" />

                                <Label Grid.Column="1"
                                       Text="{Binding EmailLabel}"
                                       Style="{StaticResource CaptionStyle}"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextSecondary}"
                                       VerticalOptions="Center" />
                            </Grid>

                            <Border Style="{StaticResource EntryContainerStyle}">
                                <Entry Placeholder="{Binding EmailPlaceholder}"
                                       Style="{StaticResource ModernEntryStyle}"
                                       Text="{Binding Email}"
                                       Keyboard="Email" />
                            </Border>
                        </StackLayout>

                        <!-- Password Field -->
                        <StackLayout Spacing="12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="lock"
                                       FontFamily="MaterialIcons"
                                       FontSize="16"
                                       TextColor="{StaticResource Primary}"
                                       VerticalOptions="Center" />

                                <Label Grid.Column="1"
                                       Text="{Binding PasswordLabel}"
                                       Style="{StaticResource CaptionStyle}"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}"
                                       VerticalOptions="Center" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Border Style="{StaticResource EntryContainerStyle}" Grid.Column="0">
                                    <Entry Placeholder="{Binding PasswordPlaceholder}"
                                           Style="{StaticResource ModernEntryStyle}"
                                           Text="{Binding Password}" />
                                </Border>

                                <!-- Generate Password Button -->
                                <Border Grid.Column="1"
                                        WidthRequest="56" HeightRequest="56"
                                        BackgroundColor="{StaticResource Primary}"
                                        StrokeShape="RoundRectangle 16">

                                    <Border.Shadow>
                                        <Shadow Brush="{StaticResource Primary}" Offset="0,4" Radius="12" Opacity="0.25" />
                                    </Border.Shadow>

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding GoToGeneratorCommand}" />
                                    </Border.GestureRecognizers>

                                    <Label Text="auto_awesome"
                                           FontFamily="MaterialIcons"
                                           FontSize="24"
                                           TextColor="{StaticResource PrimaryDarkText}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                            </Grid>
                        </StackLayout>

                    </StackLayout>
                </Border>

                <!-- Color Selection Card -->
                <Border Style="{StaticResource ElevatedCardStyle}">
                    <StackLayout Spacing="20">

                        <!-- Color Header -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Grid.Column="0"
                                   Text="palette"
                                   FontFamily="MaterialIcons"
                                   FontSize="20"
                                   TextColor="{StaticResource Primary}"
                                   VerticalOptions="Center" />

                            <StackLayout Grid.Column="1" Spacing="4">
                                <Label Text="{Binding ColorIdLabel}"
                                       Style="{StaticResource TitleStyle}"
                                       FontSize="16"
                                       TextColor="{StaticResource Primary}" />

                                <Label Text="{Binding ColorIdSubtitle}"
                                       Style="{StaticResource CaptionStyle}"
                                       Opacity="0.8" />
                            </StackLayout>
                        </Grid>

                        <!-- Color Preview -->
                        <Border WidthRequest="80" HeightRequest="80"
                                Background="{Binding SelectedColor}"
                                StrokeShape="RoundRectangle 20"
                                StrokeThickness="2"
                                Stroke="{StaticResource BorderPrimary}"
                                HorizontalOptions="Center">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleColorPickerCommand}" />
                            </Border.GestureRecognizers>

                            <Border.Shadow>
                                <Shadow Brush="{Binding SelectedColor}" Offset="0,8" Radius="20" Opacity="0.4" />
                            </Border.Shadow>

                            <Grid>
                                <!-- Background circle for better contrast -->
                                <Ellipse WidthRequest="32" HeightRequest="32"
                                         Fill="#40FFFFFF"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center" />

                                <Label Text="palette"
                                       FontFamily="MaterialIcons"
                                       FontSize="20"
                                       TextColor="{StaticResource PrimaryDarkText}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Grid>

                        </Border>

                        <!-- Color Info -->
                        <Label Text="{Binding ColorIdTapHere}"
                               Style="{StaticResource CaptionStyle}"
                               HorizontalTextAlignment="Center"
                               Opacity="0.7" />

                    </StackLayout>
                </Border>

            </StackLayout>
        </ScrollView>

        <!-- Fixed Action Buttons -->
        <Border Grid.Row="1"
                VerticalOptions="End"
                HorizontalOptions="FillAndExpand"
                BackgroundColor="{StaticResource Background}"
                Padding="24,16,24,32">

            <Border.Shadow>
                <Shadow Brush="#40000000" Offset="0,-4" Radius="16" Opacity="0.1" />
            </Border.Shadow>

            <Grid ColumnDefinitions="*" ColumnSpacing="16">

                <!-- Save Button -->
                <Button Grid.Column="1"
                        Text="{Binding SaveButtonText}"
                        Style="{StaticResource ModernButtonStyle}"
                        Command="{Binding SaveAccountCommand}">

                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialIcons"
                                         Glyph="save"
                                         Color="{StaticResource PrimaryDarkText}"
                                         Size="18" />
                    </Button.ImageSource>

                </Button>

            </Grid>
        </Border>

        <!-- Color Picker Modal -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
              IsVisible="{Binding IsColorPickerVisible}"
              BackgroundColor="#80000000">

            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseColorPickerCommand}" />
            </Grid.GestureRecognizers>

            <!-- Color Picker Card -->
            <Border Style="{StaticResource FloatingCardStyle}"
                    MaximumWidthRequest="380"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Margin="24">

                <StackLayout Spacing="24">

                    <!-- Modal Header -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackLayout Grid.Column="0" Spacing="4">
                            <Label Text="{Binding ColorPickerTitle}"
                                   Style="{StaticResource TitleStyle}"
                                   FontSize="20"
                                   TextColor="{StaticResource Primary}" />

                            <Label Text="{Binding ColorPickerSubtitle}"
                                   Style="{StaticResource CaptionStyle}"
                                   Opacity="0.8" />
                        </StackLayout>

                        <Border Grid.Column="1"
                                WidthRequest="32" HeightRequest="32"
                                BackgroundColor="{StaticResource SurfaceBackground}"
                                StrokeShape="RoundRectangle 10">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CloseColorPickerCommand}" />
                            </Border.GestureRecognizers>

                            <Label Text="close"
                                   FontFamily="MaterialIcons"
                                   FontSize="16"
                                   TextColor="{StaticResource TextTertiary}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <!-- Color Picker -->
                    <controls:ColorPicker x:Name="ColorPicker"
                                          ColorFlowDirection="Horizontal"
                                          WidthRequest="320"
                                          HeightRequest="200"
                                          ColorSpectrumStyle="ShadeToHueToTintStyle"
                                          PointerRingBorderUnits="0.3"
                                          PointerRingDiameterUnits="0.7"
                                          HorizontalOptions="Center"
                                          PickedColor="{Binding SelectedColor, Mode=TwoWay}" />

                    <!-- Hex Input -->
                    <StackLayout Spacing="8">
                        <Label Text="{Binding HexCodeLabel}"
                               Style="{StaticResource CaptionStyle}"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextSecondary}" />

                        <Border Style="{StaticResource EntryContainerStyle}">
                            <Entry Placeholder="{Binding HexCodePlaceholder}"
                                   Text="{Binding SelectedColorHex, Mode=TwoWay}"
                                   Style="{StaticResource ModernEntryStyle}"
                                   Keyboard="Text"
                                   HorizontalTextAlignment="Center" />
                        </Border>
                    </StackLayout>

                    <!-- Confirm Button -->
                    <Button Text="{Binding ConfirmColorButtonText}"
                            Style="{StaticResource ModernButtonStyle}"
                            Command="{Binding CloseColorPickerCommand}">

                        <Button.ImageSource>
                            <FontImageSource FontFamily="MaterialIcons"
                                             Glyph="check"
                                             Color="{StaticResource PrimaryDarkText}"
                                             Size="18" />
                        </Button.ImageSource>

                    </Button>

                </StackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>