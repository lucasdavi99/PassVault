<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodel="clr-namespace:PassVault.ViewModels"
    xmlns:controls="clr-namespace:Maui.ColorPicker;assembly=Maui.ColorPicker"
    x:Class="PassVault.Views.NewAccountPage"
    x:DataType="viewmodel:NewAccountPageViewModel"
    Title="Criar Conta">

    <Grid>
        <!-- Main Content -->
        <ScrollView>
            <Grid RowDefinitions="Auto,*,Auto" Padding="24">

                <!-- Header -->
                <StackLayout Grid.Row="0" Spacing="8" Margin="0,20,0,32">
                    <Label Text="Nova Conta"
                           Style="{StaticResource HeadlineStyle}"
                           TextColor="{StaticResource Primary}" />

                    <Label Text="Preencha as informações da sua nova conta"
                           Style="{StaticResource BodyStyle}"
                           HorizontalTextAlignment="Center" />
                </StackLayout>

                <!-- Form Content -->
                <StackLayout Grid.Row="1" Spacing="24">

                    <!-- Title Field -->
                    <StackLayout Spacing="8">
                        <Label Text="Título da Conta *"
                               Style="{StaticResource CaptionStyle}"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" />

                        <Border Style="{StaticResource EntryContainerStyle}">
                            <Entry Placeholder="Ex: Gmail, Instagram, GitHub..."
                                   Style="{StaticResource ModernEntryStyle}"
                                   Text="{Binding Title}" />
                        </Border>
                    </StackLayout>

                    <!-- Username Field -->
                    <StackLayout Spacing="8" IsVisible="{Binding IsUsernameVisible}">
                        <Label Text="Nome de Usuário"
                               Style="{StaticResource CaptionStyle}"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextSecondary}" />

                        <Border Style="{StaticResource EntryContainerStyle}">
                            <Entry Placeholder="Digite seu nome de usuário"
                                   Style="{StaticResource ModernEntryStyle}"
                                   Text="{Binding Username}" />
                        </Border>
                    </StackLayout>

                    <!-- Email Field -->
                    <StackLayout Spacing="8" IsVisible="{Binding IsEmailVisible}">
                        <Label Text="E-mail"
                               Style="{StaticResource CaptionStyle}"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextSecondary}" />

                        <Border Style="{StaticResource EntryContainerStyle}">
                            <Entry Placeholder="exemplo@email.com"
                                   Style="{StaticResource ModernEntryStyle}"
                                   Text="{Binding Email}"
                                   Keyboard="Email" />
                        </Border>
                    </StackLayout>

                    <!-- Password Field -->
                    <StackLayout Spacing="8">
                        <Label Text="Senha *"
                               Style="{StaticResource CaptionStyle}"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Border Style="{StaticResource EntryContainerStyle}" Grid.Column="0">
                                <Entry Placeholder="Digite uma senha segura"
                                       Style="{StaticResource ModernEntryStyle}"
                                       Text="{Binding Password}" />
                            </Border>

                            <!-- Generate Password Button -->
                            <Button Grid.Column="1"
                                    Text="auto_awesome"
                                    FontFamily="MaterialIcons"
                                    Style="{StaticResource IconButtonStyle}"
                                    WidthRequest="48" HeightRequest="48"
                                    CornerRadius="12"
                                    Margin="8,0,0,0"
                                    Command="{Binding GoToGeneratorCommand}" />
                        </Grid>
                    </StackLayout>

                    <!-- Color Selection -->
                    <StackLayout Spacing="12">
                        <Label Text="Cor de Identificação"
                               Style="{StaticResource CaptionStyle}"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextSecondary}" />

                        <Border WidthRequest="60" HeightRequest="60"
                                Background="{Binding SelectedColor}"
                                StrokeShape="RoundRectangle 16"
                                StrokeThickness="3"
                                Stroke="{StaticResource BorderPrimary}"
                                HorizontalOptions="Center">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleColorPickerCommand}" />
                            </Border.GestureRecognizers>

                            <Border.Shadow>
                                <Shadow Brush="{Binding SelectedColor}" Offset="0,4" Radius="12" Opacity="0.4" />
                            </Border.Shadow>

                            <Label Text="palette"
                                   FontFamily="MaterialIcons"
                                   FontSize="24"
                                   TextColor="{StaticResource PrimaryDarkText}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />

                        </Border>
                    </StackLayout>

                </StackLayout>

                <!-- Action Buttons -->
                <Grid Grid.Row="2" 
                      ColumnDefinitions="*,*" 
                      ColumnSpacing="16" 
                      Margin="0,32,0,0">

                    <!-- Cancel/Back Button -->
                    <Button Grid.Column="0"
                            Text="Cancelar"
                            BackgroundColor="{StaticResource ElevatedSurface}"
                            TextColor="{StaticResource TextSecondary}"
                            Style="{StaticResource ModernButtonStyle}" />

                    <!-- Save Button -->
                    <Button Grid.Column="1"
                            Text="Salvar Conta"
                            Style="{StaticResource ModernButtonStyle}"
                            Command="{Binding SaveAccountCommand}" />

                </Grid>

            </Grid>
        </ScrollView>

        <!-- Color Picker Overlay -->
        <Grid IsVisible="{Binding IsColorPickerVisible}"
              BackgroundColor="{StaticResource PressedOverlay}"
              RowDefinitions="*,Auto,*">

            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseColorPickerCommand}" />
            </Grid.GestureRecognizers>

            <!-- Color Picker Card -->
            <Border Grid.Row="1"
                    Style="{StaticResource ElevatedCardStyle}"
                    Margin="24"
                    MaximumWidthRequest="350">

                <StackLayout Spacing="20">

                    <Label Text="Escolher Cor"
                           Style="{StaticResource TitleStyle}"
                           HorizontalTextAlignment="Center"
                           TextColor="{StaticResource Primary}" />

                    <!-- Color Picker -->
                    <controls:ColorPicker x:Name="ColorPicker"
                                          ColorFlowDirection="Horizontal"
                                          WidthRequest="300"
                                          HeightRequest="200"
                                          ColorSpectrumStyle="ShadeToHueToTintStyle"
                                          PointerRingBorderUnits="0.3"
                                          PointerRingDiameterUnits="0.7"
                                          HorizontalOptions="Center"
                                          PickedColor="{Binding SelectedColor, Mode=TwoWay}" />

                    <!-- Hex Input -->
                    <Border Style="{StaticResource EntryContainerStyle}">
                        <Entry Placeholder="Código hexadecimal (ex: #FF5733)"
                               Text="{Binding SelectedColorHex, Mode=TwoWay}"
                               Style="{StaticResource ModernEntryStyle}"
                               Keyboard="Text"
                               HorizontalTextAlignment="Center" />
                    </Border>

                    <!-- Close Button -->
                    <Button Text="Confirmar"
                            Style="{StaticResource ModernButtonStyle}"
                            Command="{Binding CloseColorPickerCommand}" />

                </StackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>