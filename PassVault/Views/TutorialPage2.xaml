<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:PassVault.ViewModels"
             x:Class="PassVault.Views.TutorialPage2"
             x:DataType="viewModels:TutorialPage2ViewModel"
             Shell.NavBarIsVisible="False"
             Title="TutorialPage2">

    <ContentPage.BindingContext>
        <viewModels:TutorialPage2ViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Hero Section -->
        <StackLayout Grid.Row="0" 
                     Spacing="24" 
                     Padding="24,60,24,16">

            <!-- Security Icon with Animation -->
            <Border WidthRequest="100" HeightRequest="100"
                    BackgroundColor="{StaticResource Success}"
                    StrokeShape="RoundRectangle 28"
                    HorizontalOptions="Center">

                <Border.Shadow>
                    <Shadow Brush="{StaticResource Success}" Offset="0,12" Radius="32" Opacity="0.3" />
                </Border.Shadow>

                <Grid>
                    <!-- Background rings for security effect -->
                    <Ellipse WidthRequest="70" HeightRequest="70"
                             Stroke="{StaticResource Success}"
                             StrokeThickness="2"
                             Fill="Transparent"
                             Opacity="0.3"
                             HorizontalOptions="Center"
                             VerticalOptions="Center" />

                    <Ellipse WidthRequest="50" HeightRequest="50"
                             Stroke="{StaticResource Success}"
                             StrokeThickness="2"
                             Fill="Transparent"
                             Opacity="0.5"
                             HorizontalOptions="Center"
                             VerticalOptions="Center" />

                    <Ellipse WidthRequest="30" HeightRequest="30"
                             Fill="#40FFFFFF"
                             HorizontalOptions="Center"
                             VerticalOptions="Center" />

                    <Label Text="enhanced_encryption"
                           FontFamily="MaterialIcons"
                           FontSize="32"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Grid>

            </Border>

            <!-- Title -->
            <Label Text="{Binding Title}"
                   Style="{StaticResource HeadlineStyle}"
                   FontSize="28"
                   TextColor="{StaticResource Primary}"
                   HorizontalTextAlignment="Center"
                   LineHeight="1.2">

                <Label.Shadow>
                    <Shadow Brush="{StaticResource Primary}" Offset="0,2" Radius="8" Opacity="0.2" />
                </Label.Shadow>

            </Label>

        </StackLayout>

        <!-- Content Section -->
        <ScrollView Grid.Row="1" Padding="24,16,24,24">
            <StackLayout Spacing="24" VerticalOptions="FillAndExpand">

                <!-- Description Card -->
                <Border Style="{StaticResource ElevatedCardStyle}"
                        MaximumWidthRequest="400"
                        HorizontalOptions="Center">

                    <StackLayout Spacing="20">

                        <!-- Security Features Header -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                            <Border Grid.Column="0"
                                    WidthRequest="40" HeightRequest="40"
                                    BackgroundColor="{StaticResource Success}"
                                    StrokeShape="RoundRectangle 12">

                                <Label Text="verified_user"
                                       FontFamily="MaterialIcons"
                                       FontSize="20"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <StackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Segurança Avançada"
                                       Style="{StaticResource TitleStyle}"
                                       FontSize="18"
                                       TextColor="{StaticResource Success}" />

                                <Label Text="Proteção de nível militar"
                                       Style="{StaticResource CaptionStyle}"
                                       Opacity="0.8" />
                            </StackLayout>
                        </Grid>

                        <!-- Main Description -->
                        <Label Text="{Binding Description}"
                               Style="{StaticResource BodyStyle}"
                               FontSize="16"
                               HorizontalTextAlignment="Center"
                               LineHeight="1.5" />

                        <!-- Security Features -->
                        <StackLayout Spacing="12">

                            <!-- AES Encryption -->
                            <Border BackgroundColor="{StaticResource ElevatedSurface}"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="16,12">

                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Label Grid.Column="0"
                                           Text="lock"
                                           FontFamily="MaterialIcons"
                                           FontSize="18"
                                           TextColor="{StaticResource Success}"
                                           VerticalOptions="Center" />

                                    <StackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="Criptografia AES-256"
                                               Style="{StaticResource CaptionStyle}"
                                               FontAttributes="Bold"
                                               FontSize="14" />

                                        <Label Text="Padrão militar de segurança"
                                               Style="{StaticResource CaptionStyle}"
                                               FontSize="12"
                                               Opacity="0.7" />
                                    </StackLayout>

                                    <Label Grid.Column="2"
                                           Text="shield"
                                           FontFamily="MaterialIcons"
                                           FontSize="16"
                                           TextColor="{StaticResource Success}"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>

                            <!-- Local Storage -->
                            <Border BackgroundColor="{StaticResource ElevatedSurface}"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="16,12">

                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Label Grid.Column="0"
                                           Text="storage"
                                           FontFamily="MaterialIcons"
                                           FontSize="18"
                                           TextColor="{StaticResource Primary}"
                                           VerticalOptions="Center" />

                                    <StackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="Armazenamento Local"
                                               Style="{StaticResource CaptionStyle}"
                                               FontAttributes="Bold"
                                               FontSize="14" />

                                        <Label Text="Apenas no seu dispositivo"
                                               Style="{StaticResource CaptionStyle}"
                                               FontSize="12"
                                               Opacity="0.7" />
                                    </StackLayout>

                                    <Label Grid.Column="2"
                                           Text="offline_bolt"
                                           FontFamily="MaterialIcons"
                                           FontSize="16"
                                           TextColor="{StaticResource Primary}"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>

                            <!-- Zero Knowledge -->
                            <Border BackgroundColor="{StaticResource ElevatedSurface}"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="16,12">

                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Label Grid.Column="0"
                                           Text="visibility_off"
                                           FontFamily="MaterialIcons"
                                           FontSize="18"
                                           TextColor="{StaticResource Info}"
                                           VerticalOptions="Center" />

                                    <StackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="Zero Conhecimento"
                                               Style="{StaticResource CaptionStyle}"
                                               FontAttributes="Bold"
                                               FontSize="14" />

                                        <Label Text="Nós não vemos seus dados"
                                               Style="{StaticResource CaptionStyle}"
                                               FontSize="12"
                                               Opacity="0.7" />
                                    </StackLayout>

                                    <Label Grid.Column="2"
                                           Text="privacy_tip"
                                           FontFamily="MaterialIcons"
                                           FontSize="16"
                                           TextColor="{StaticResource Info}"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>

                        </StackLayout>

                    </StackLayout>
                </Border>

                <!-- Espaçamento extra para evitar sobreposição -->
                <BoxView HeightRequest="100" BackgroundColor="Transparent" />

            </StackLayout>
        </ScrollView>

        <!-- Navigation Section -->
        <StackLayout Grid.Row="2" 
                     Spacing="24" 
                     Padding="24,0,24,60"
                     VerticalOptions="End">

            <!-- Progress Indicator -->
            <StackLayout Spacing="12" HorizontalOptions="Center">
                <Label Text="2 de 5"
                       Style="{StaticResource CaptionStyle}"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Primary}"
                       HorizontalTextAlignment="Center" />

                <!-- Progress Dots -->
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" HorizontalOptions="Center">

                    <!-- Dot 1 - Completed -->
                    <Ellipse Grid.Column="0"
                             WidthRequest="8" HeightRequest="8"
                             Fill="{StaticResource Success}"
                             Opacity="0.7" />

                    <!-- Dot 2 - Active -->
                    <Ellipse Grid.Column="1"
                             WidthRequest="12" HeightRequest="12"
                             Fill="{StaticResource Primary}" />

                    <!-- Dot 3 -->
                    <Ellipse Grid.Column="2"
                             WidthRequest="8" HeightRequest="8"
                             Fill="{StaticResource TextTertiary}"
                             Opacity="0.5" />

                    <!-- Dot 4 -->
                    <Ellipse Grid.Column="3"
                             WidthRequest="8" HeightRequest="8"
                             Fill="{StaticResource TextTertiary}"
                             Opacity="0.5" />

                    <!-- Dot 5 -->
                    <Ellipse Grid.Column="4"
                             WidthRequest="8" HeightRequest="8"
                             Fill="{StaticResource TextTertiary}"
                             Opacity="0.5" />

                </Grid>
            </StackLayout>

            <!-- Action Buttons -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">               

                <!-- Next Button -->
                <Border Grid.Column="1"
                        WidthRequest="120" HeightRequest="56"
                        BackgroundColor="{StaticResource Primary}"
                        StrokeShape="RoundRectangle 16">

                    <Border.Shadow>
                        <Shadow Brush="{StaticResource Primary}" Offset="0,6" Radius="20" Opacity="0.35" />
                    </Border.Shadow>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NextPageCommand}"/>
                    </Border.GestureRecognizers>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalOptions="Center" HorizontalOptions="Center">
                        <Label Grid.Column="0"
                               Text="Próximo"
                               Style="{StaticResource CaptionStyle}"
                               FontAttributes="Bold"
                               FontSize="16"
                               TextColor="{StaticResource PrimaryDarkText}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />

                        <Label Grid.Column="1"
                               Text="arrow_forward"
                               FontFamily="MaterialIcons"
                               FontSize="20"
                               TextColor="{StaticResource PrimaryDarkText}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />
                    </Grid>

                </Border>

            </Grid>

        </StackLayout>

    </Grid>
</ContentPage>