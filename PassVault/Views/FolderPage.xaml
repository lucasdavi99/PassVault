<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:PassVault.ViewModels"
             xmlns:models="clr-namespace:PassVault.Models"
             xmlns:converters="clr-namespace:PassVault.Converters"
             x:Class="PassVault.Views.FolderPage"
             x:DataType="viewModels:FolderPageViewModel"
             Title="{Binding Folder.Title}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:HexToColorConverter x:Key="HexToColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Shell.TitleView>
        <Grid BackgroundColor="Transparent" Padding="0,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Folder Title with Icon -->
            <StackLayout Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalOptions="Center">
                <Label Text="folder"
                       FontFamily="MaterialIcons"
                       TextColor="{StaticResource Primary}"
                       FontSize="24"
                       VerticalOptions="Center" />

                <Label Text="{Binding Folder.Title}" 
                       TextColor="{StaticResource Primary}" 
                       FontSize="20"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />
            </StackLayout>

            <!-- Edit Button -->
            <Border Grid.Column="1"
                    WidthRequest="36" HeightRequest="36"
                    BackgroundColor="{StaticResource ElevatedSurface}"
                    StrokeShape="RoundRectangle 10"
                    Stroke="{StaticResource BorderPrimary}">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding EditFolderCommand}" CommandParameter="{Binding Folder}" />
                </Border.GestureRecognizers>

                <Label Text="edit"
                       FontFamily="MaterialIcons"
                       TextColor="{StaticResource Primary}"
                       FontSize="18"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>
        </Grid>
    </Shell.TitleView>

    <Grid RowDefinitions="*,Auto">

        <!-- Content Area -->
        <ScrollView Grid.Row="0" Padding="16,8,16,24">
            <StackLayout Spacing="8">

                <!-- Empty State -->
                <StackLayout IsVisible="{Binding Accounts.Count, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=0}"
                             Spacing="16" Padding="32" VerticalOptions="CenterAndExpand">

                    <Border WidthRequest="80" HeightRequest="80"
                            BackgroundColor="{StaticResource ElevatedSurface}"
                            StrokeShape="RoundRectangle 24"
                            Stroke="{StaticResource BorderPrimary}"
                            HorizontalOptions="Center">

                        <Label Text="folder_open"
                               FontFamily="MaterialIcons"
                               FontSize="40"
                               TextColor="{StaticResource TextTertiary}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <Label Text="Pasta Vazia"
                           Style="{StaticResource TitleStyle}"
                           HorizontalTextAlignment="Center"
                           TextColor="{StaticResource TextSecondary}" />

                    <Label Text="Adicione contas para organizar suas senhas"
                           Style="{StaticResource BodyStyle}"
                           HorizontalTextAlignment="Center" />

                </StackLayout>

                <!-- Accounts List -->
                <CollectionView ItemsSource="{Binding Accounts}">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="8"/>
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Account">
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItems>
                                        <SwipeItem Text="Excluir"
                                                   BackgroundColor="{StaticResource Error}"
                                                   Command="{Binding x:DataType='viewModels:FolderPageViewModel',Source={RelativeSource AncestorType={x:Type viewModels:FolderPageViewModel}}, Path=DeleteAccountInFolderCommand}"
                                                   CommandParameter="{Binding .}" />
                                    </SwipeItems>
                                </SwipeView.RightItems>

                                <Border Style="{StaticResource ListItemStyle}"
                                        MinimumWidthRequest="300"
                                        MaximumWidthRequest="400">

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding x:DataType='viewModels:FolderPageViewModel',Source={RelativeSource AncestorType={x:Type viewModels:FolderPageViewModel}}, Path=EditAccountInFolderCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">

                                        <!-- Account Icon -->
                                        <Border WidthRequest="40" HeightRequest="40"
                                                BackgroundColor="{Binding Color, Converter={StaticResource HexToColorConverter}}"
                                                StrokeShape="RoundRectangle 12"
                                                Grid.Column="0"
                                                VerticalOptions="Center">

                                            <Label Text="key"
                                                   FontFamily="MaterialIcons"
                                                   FontSize="20"
                                                   TextColor="{StaticResource PrimaryDarkText}"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                        </Border>

                                        <!-- Account Info -->
                                        <StackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">

                                            <Label Text="{Binding Title}"
                                                   Style="{StaticResource TitleStyle}"
                                                   FontSize="18" />

                                            <Label Text="{Binding Created, StringFormat='Criado em {0:dd/MM/yyyy}'}"
                                                   Style="{StaticResource CaptionStyle}" />

                                        </StackLayout>

                                        <!-- Access Indicator -->
                                        <Label Text="chevron_right"
                                               FontFamily="MaterialIcons"
                                               FontSize="20"
                                               TextColor="{StaticResource TextTertiary}"
                                               Grid.Column="2"
                                               VerticalOptions="Center" />

                                    </Grid>
                                </Border>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>
        </ScrollView>

        <!-- Floating Action Menu -->
        <Border Grid.Row="1"
                Style="{StaticResource NavigationMenuStyle}"
                WidthRequest="200"
                HeightRequest="76"
                HorizontalOptions="Center"
                VerticalOptions="End"
                Margin="0,0,0,24">

            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">

                <!-- Home Button -->
                <Button Grid.Column="0"
                        Style="{StaticResource IconButtonStyle}"
                        Text="home"
                        FontSize="24"
                        Command="{Binding GoToHomeCommand}" />

                <!-- Add Button -->
                <Button Grid.Column="1"
                        WidthRequest="56" HeightRequest="56"
                        CornerRadius="28"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="{StaticResource PrimaryDarkText}"
                        FontFamily="MaterialIcons"
                        FontSize="32"
                        Text="add"
                        Padding="0"
                        Command="{Binding AddNewItemCommand}">

                    <Button.Shadow>
                        <Shadow Brush="{StaticResource Black}" Offset="0,4" Radius="12" Opacity="0.25" />
                    </Button.Shadow>

                </Button>

            </Grid>
        </Border>
    </Grid>
</ContentPage>