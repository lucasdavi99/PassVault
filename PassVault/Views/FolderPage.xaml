<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:PassVault.ViewModels"
             xmlns:models="clr-namespace:PassVault.Models"
             xmlns:converters="clr-namespace:PassVault.Converters"
             x:Class="PassVault.Views.FolderPage"
             x:DataType="viewModels:FolderPageViewModel"
             Shell.NavBarIsVisible="False"
             Title="{Binding Folder.Title}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:HexToColorConverter x:Key="HexToColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Modern Header -->
        <Border Grid.Row="0" 
                Background="{StaticResource SurfaceGradient}"
                Padding="0,50,0,32"
                StrokeShape="RoundRectangle 0,0,28,28">

            <StackLayout Spacing="16">

                <!-- Folder Header -->
                <Grid ColumnDefinitions="Auto,*,Auto" 
                      ColumnSpacing="16"
                      HorizontalOptions="Center">

                    <!-- Folder Icon -->
                    <Border Grid.Column="0"
                            WidthRequest="56" HeightRequest="56"
                            BackgroundColor="{Binding Folder.Color, Converter={StaticResource HexToColorConverter}}"
                            StrokeShape="RoundRectangle 18">

                        <Border.Shadow>
                            <Shadow Brush="{Binding Folder.Color, Converter={StaticResource HexToColorConverter}}" 
                                    Offset="0,6" Radius="16" Opacity="0.4" />
                        </Border.Shadow>

                        <Label Text="folder"
                               FontFamily="MaterialIcons"
                               FontSize="28"
                               TextColor="{StaticResource PrimaryDarkText}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <!-- Folder Info -->
                    <StackLayout Grid.Column="1" 
                                 VerticalOptions="Center"
                                 Spacing="4">

                        <Label Text="{Binding Folder.Title, TargetNullValue='Carregando...'}"
                               Style="{StaticResource HeadlineStyle}"
                               FontSize="24"
                               TextColor="{StaticResource Primary}"
                               HorizontalTextAlignment="Start" />

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label Grid.Column="0"
                                   Text="inventory"
                                   FontFamily="MaterialIcons"
                                   FontSize="14"
                                   TextColor="{StaticResource TextTertiary}"
                                   VerticalOptions="Center" />

                            <Label Grid.Column="1"
                                   Text="{Binding Accounts.Count, StringFormat='{0} contas'}"
                                   Style="{StaticResource CaptionStyle}"
                                   HorizontalTextAlignment="Start"
                                   VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding Accounts.Count}" Value="0">
                                        <Setter Property="Text" Value="Nenhuma conta" />
                                        <Setter Property="TextColor" Value="{StaticResource TextTertiary}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding Accounts.Count}" Value="1">
                                        <Setter Property="Text" Value="1 conta" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Grid>
                    </StackLayout>

                    <!-- Edit Button -->
                    <Button Grid.Column="2"
                            Command="{Binding EditFolderCommand}"
                            CommandParameter="{Binding Folder}"
                            WidthRequest="40" HeightRequest="40"
                            BackgroundColor="{StaticResource Secondary}"
                            CornerRadius="20"
                            Text="edit"
                            FontFamily="MaterialIcons"
                            FontSize="20"
                            TextColor="{StaticResource SecondaryDarkText}"
                            Padding="0" />
                </Grid>

                <!-- Action Category Badge -->
                <Border BackgroundColor="{StaticResource ElevatedSurface}"
                        StrokeShape="RoundRectangle 20"
                        Stroke="{StaticResource BorderPrimary}"
                        StrokeThickness="0.5"
                        HorizontalOptions="Center"
                        Padding="16,8">

                    <Border.Shadow>
                        <Shadow Brush="#15000000" Offset="0,2" Radius="8" Opacity="0.08" />
                    </Border.Shadow>

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Label Grid.Column="0"
                               Text="folder_open"
                               FontFamily="MaterialIcons"
                               FontSize="16"
                               TextColor="{StaticResource Primary}"
                               VerticalOptions="Center" />

                        <Label Grid.Column="1"
                               Text="Pasta de Contas"
                               Style="{StaticResource CaptionStyle}"
                               FontSize="12"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               VerticalOptions="Center" />

                        <Label Grid.Column="2"
                               Text="security"
                               FontFamily="MaterialIcons"
                               FontSize="16"
                               TextColor="{StaticResource Primary}"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

            </StackLayout>
        </Border>

        <!-- Content Area -->
        <ScrollView Grid.Row="1" Padding="20,16,20,24">
            <StackLayout Spacing="12">

                <StackLayout Spacing="32" 
                             Padding="40,80"
                             VerticalOptions="CenterAndExpand"
                             IsVisible="{Binding IsEmpty}"
                             x:Name="EmptyStateLayout">

                    <Border WidthRequest="120" HeightRequest="120"
                            BackgroundColor="{StaticResource ElevatedSurface}"
                            StrokeShape="RoundRectangle 32"
                            Stroke="{StaticResource BorderPrimary}"
                            HorizontalOptions="Center">

                        <Border.Shadow>
                            <Shadow Brush="#25000000" Offset="0,12" Radius="32" Opacity="0.15" />
                        </Border.Shadow>

                        <StackLayout Spacing="8" VerticalOptions="Center">
                            <Label Text="folder_open"
                                   FontFamily="MaterialIcons"
                                   FontSize="48"
                                   TextColor="{StaticResource TextTertiary}"
                                   HorizontalOptions="Center" />

                            <Label Text="folder_add"
                                   FontFamily="MaterialIcons"
                                   FontSize="24"
                                   TextColor="{StaticResource Primary}"
                                   HorizontalOptions="Center" />
                        </StackLayout>
                    </Border>

                    <StackLayout Spacing="16">
                        <Label Text="Pasta Vazia"
                               Style="{StaticResource TitleStyle}"
                               FontSize="22"
                               HorizontalTextAlignment="Center"
                               TextColor="{StaticResource TextSecondary}" />

                        <Label Text="Esta pasta ainda não possui contas. Toque no botão + para adicionar a primeira conta."
                               Style="{StaticResource BodyStyle}"
                               HorizontalTextAlignment="Center"
                               TextColor="{StaticResource TextTertiary}"
                               Opacity="0.8" />
                    </StackLayout>

                    <Button Text="Adicionar Primeira Conta"
                            Command="{Binding AddNewItemCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalOptions="Center"
                            Padding="32,12" />

                </StackLayout>

                <StackLayout IsVisible="{Binding HasAccounts}" Spacing="8">

                    <CollectionView ItemsSource="{Binding Accounts}"
                                    BackgroundColor="Transparent"
                                    SelectionMode="None">

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Account">
                                <SwipeView>
                                    <SwipeView.RightItems>
                                        <SwipeItems>
                                            <SwipeItem Text="Editar"
                                                       IconImageSource="edit.png"
                                                       BackgroundColor="{StaticResource Primary}"
                                                       Command="{Binding Source={x:Reference Name=this}, Path=BindingContext.EditAccountInFolderCommand}"
                                                       CommandParameter="{Binding .}" />
                                            <SwipeItem Text="Excluir"
                                                       IconImageSource="delete.png"
                                                       BackgroundColor="{StaticResource Error}"
                                                       Command="{Binding Source={x:Reference Name=this}, Path=BindingContext.DeleteAccountInFolderCommand}"
                                                       CommandParameter="{Binding .}" />
                                        </SwipeItems>
                                    </SwipeView.RightItems>

                                    <Border BackgroundColor="{StaticResource CardBackground}"
                                            StrokeShape="RoundRectangle 16"
                                            Stroke="{StaticResource BorderPrimary}"
                                            StrokeThickness="0.5"
                                            Margin="0,4"
                                            Padding="0">

                                        <Border.Shadow>
                                            <Shadow Brush="#10000000" Offset="0,2" Radius="8" Opacity="0.06" />
                                        </Border.Shadow>

                                        <Grid ColumnDefinitions="Auto,*,Auto" 
                                              ColumnSpacing="16" 
                                              Padding="20,16">

                                            <!-- Account Color Indicator -->
                                            <Border Grid.Column="0"
                                                    WidthRequest="40" HeightRequest="40"
                                                    BackgroundColor="{Binding Color, Converter={StaticResource HexToColorConverter}}"
                                                    StrokeShape="RoundRectangle 12">

                                                <Label Text="key"
                                                       FontFamily="MaterialIcons"
                                                       FontSize="20"
                                                       TextColor="{StaticResource PrimaryDarkText}"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                            </Border>

                                            <!-- Account Info -->
                                            <StackLayout Grid.Column="1" 
                                                         Spacing="4"
                                                         VerticalOptions="Center">

                                                <Label Text="{Binding Title}"
                                                       Style="{StaticResource SubheadStyle}"
                                                       FontSize="16"
                                                       TextColor="{StaticResource TextPrimary}" />

                                                <!-- Dynamic subtitle based on available fields -->
                                                <Label Style="{StaticResource CaptionStyle}"
                                                       TextColor="{StaticResource TextSecondary}"
                                                       FontSize="14">
                                                    <Label.Triggers>
                                                        <!-- If both username and email are available -->
                                                        <MultiTrigger TargetType="Label">
                                                            <MultiTrigger.Conditions>
                                                                <BindingCondition Binding="{Binding Username, Converter={StaticResource StringToBooleanConverter}}" Value="True" />
                                                                <BindingCondition Binding="{Binding Email, Converter={StaticResource StringToBooleanConverter}}" Value="True" />
                                                            </MultiTrigger.Conditions>
                                                            <Setter Property="Text" Value="{Binding Username}" />
                                                        </MultiTrigger>
                                                        <!-- If only email is available -->
                                                        <MultiTrigger TargetType="Label">
                                                            <MultiTrigger.Conditions>
                                                                <BindingCondition Binding="{Binding Username, Converter={StaticResource StringToBooleanConverter}}" Value="False" />
                                                                <BindingCondition Binding="{Binding Email, Converter={StaticResource StringToBooleanConverter}}" Value="True" />
                                                            </MultiTrigger.Conditions>
                                                            <Setter Property="Text" Value="{Binding Email}" />
                                                        </MultiTrigger>
                                                        <!-- If only username is available -->
                                                        <MultiTrigger TargetType="Label">
                                                            <MultiTrigger.Conditions>
                                                                <BindingCondition Binding="{Binding Username, Converter={StaticResource StringToBooleanConverter}}" Value="True" />
                                                                <BindingCondition Binding="{Binding Email, Converter={StaticResource StringToBooleanConverter}}" Value="False" />
                                                            </MultiTrigger.Conditions>
                                                            <Setter Property="Text" Value="{Binding Username}" />
                                                        </MultiTrigger>
                                                        <!-- If neither is available -->
                                                        <MultiTrigger TargetType="Label">
                                                            <MultiTrigger.Conditions>
                                                                <BindingCondition Binding="{Binding Username, Converter={StaticResource StringToBooleanConverter}}" Value="False" />
                                                                <BindingCondition Binding="{Binding Email, Converter={StaticResource StringToBooleanConverter}}" Value="False" />
                                                            </MultiTrigger.Conditions>
                                                            <Setter Property="Text" Value="Toque para visualizar" />
                                                        </MultiTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </StackLayout>

                                            <!-- Navigation Arrow -->
                                            <Label Grid.Column="2"
                                                   Text="chevron_right"
                                                   FontFamily="MaterialIcons"
                                                   FontSize="20"
                                                   TextColor="{StaticResource TextTertiary}"
                                                   VerticalOptions="Center" />
                                        </Grid>

                                        <!-- Tap Gesture -->
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={x:Reference Name=this}, Path=BindingContext.EditAccountInFolderCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                    </Border>
                                </SwipeView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>

            </StackLayout>
        </ScrollView>

        <!-- Floating Action Button -->
        <Button Grid.Row="2"
                Command="{Binding AddNewItemCommand}"
                Text="add"
                FontFamily="MaterialIcons"
                FontSize="24"
                TextColor="{StaticResource PrimaryDarkText}"
                BackgroundColor="{StaticResource Primary}"
                WidthRequest="56" HeightRequest="56"
                CornerRadius="28"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="20,0,20,30"
                Padding="0">

            <Button.Shadow>
                <Shadow Brush="{StaticResource Primary}" Offset="0,4" Radius="12" Opacity="0.3" />
            </Button.Shadow>
        </Button>

    </Grid>
</ContentPage>