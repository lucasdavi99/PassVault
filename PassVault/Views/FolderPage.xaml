<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:PassVault.ViewModels"
             xmlns:models="clr-namespace:PassVault.Models"
             xmlns:converters="clr-namespace:PassVault.Converters"
             x:Class="PassVault.Views.FolderPage"
             x:DataType="viewModels:FolderPageViewModel"
             Shell.NavBarIsVisible="True">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:HexToColorConverter x:Key="HexToColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Modern Header -->
        <Border Grid.Row="0" 
                Background="{StaticResource SurfaceGradient}"
                Padding="0,30,0,24"
                StrokeShape="RoundRectangle 0,0,28,28">

            <StackLayout Spacing="16">

                <!-- Folder Header -->
                <Grid ColumnDefinitions="Auto,*,Auto" 
                      ColumnSpacing="16"
                      Margin="20,0">

                    <!-- Folder Info -->
                    <StackLayout Grid.Column="1" 
                                 VerticalOptions="Center"
                                 Spacing="4">

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <!-- Folder Icon -->
                            <Border Grid.Column="0"
                                    WidthRequest="48" HeightRequest="48"
                                    BackgroundColor="{Binding Folder.Color, Converter={StaticResource HexToColorConverter}}"
                                    StrokeShape="RoundRectangle 16">

                                <Border.Shadow>
                                    <Shadow Brush="{Binding Folder.Color, Converter={StaticResource HexToColorConverter}}" 
                                            Offset="0,4" Radius="12" Opacity="0.3" />
                                </Border.Shadow>

                                <Label Text="folder"
                                       FontFamily="MaterialIcons"
                                       FontSize="24"
                                       TextColor="{StaticResource PrimaryDarkText}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <StackLayout Grid.Column="1"  Spacing="2">
                                <Label Text="{Binding Folder.Title}"
                                       Style="{StaticResource HeadlineStyle}"
                                       FontSize="20"
                                       TextColor="{StaticResource Primary}" />

                                <Label Text="Gerencie contas e pastas"
                                       Style="{StaticResource CaptionStyle}"
                                       Opacity="0.8" 
                                       HorizontalTextAlignment="Center"
                                       HorizontalOptions="Center"/>
                            </StackLayout>
                        </Grid>
                    </StackLayout>

                    <!-- Edit Button -->
                    <Border Grid.Column="2"
                            WidthRequest="44" HeightRequest="44"
                            BackgroundColor="{StaticResource ElevatedSurface}"
                            StrokeShape="RoundRectangle 14"
                            Stroke="{StaticResource BorderPrimary}">

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding EditFolderCommand}" CommandParameter="{Binding Folder}" />
                        </Border.GestureRecognizers>

                        <Label Text="edit"
                               FontFamily="MaterialIcons"
                               FontSize="18"
                               TextColor="{StaticResource TextSecondary}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                </Grid>
            </StackLayout>
        </Border>

        <!-- Tab Navigation -->
        <Border Grid.Row="1" 
                Background="{StaticResource CardBackground}"
                Margin="20,16,20,0"
                StrokeShape="RoundRectangle 16,16,0,0"
                Stroke="{StaticResource BorderPrimary}">

            <Grid ColumnDefinitions="*,*" 
                  HeightRequest="54">

                <!-- Tab Contas -->
                <Border Grid.Column="0"
                        StrokeShape="RoundRectangle 12"
                        Margin="6">

                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsAccountsTabActive}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding IsAccountsTabActive}" Value="False">
                            <Setter Property="BackgroundColor" Value="Transparent" />
                        </DataTrigger>
                    </Border.Triggers>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShowAccountsTabCommand}" />
                    </Border.GestureRecognizers>

                    <!-- icone de contas -->
                    <StackLayout Orientation="Horizontal" 
                                 Spacing="6"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">

                        <Label Text="key"
                               FontFamily="MaterialIcons"
                               FontSize="18"
                               VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsAccountsTabActive}" Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource PrimaryDarkText}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding IsAccountsTabActive}" Value="False">
                                    <Setter Property="TextColor" Value="{StaticResource TextTertiary}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>

                        <Label Text="Contas"
                               Style="{StaticResource TitleStyle}"
                               FontSize="14"
                               FontAttributes="Bold"
                               VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsAccountsTabActive}" Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource PrimaryDarkText}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding IsAccountsTabActive}" Value="False">
                                    <Setter Property="TextColor" Value="{StaticResource TextTertiary}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </StackLayout>
                </Border>

                <!-- Tab Pastas -->
                <Border Grid.Column="1"
                        StrokeShape="RoundRectangle 12"
                        Margin="6">

                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsFoldersTabActive}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding IsFoldersTabActive}" Value="False">
                            <Setter Property="BackgroundColor" Value="Transparent" />
                        </DataTrigger>
                    </Border.Triggers>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShowFoldersTabCommand}" />
                    </Border.GestureRecognizers>

                    <!-- icone pasta -->
                    <StackLayout Orientation="Horizontal" 
                                 Spacing="6"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">

                        <Label Text="folder"
                               FontFamily="MaterialIcons"
                               FontSize="18"
                               VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsFoldersTabActive}" Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource PrimaryDarkText}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding IsFoldersTabActive}" Value="False">
                                    <Setter Property="TextColor" Value="{StaticResource TextTertiary}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>

                        <Label Text="Pastas"
                               Style="{StaticResource TitleStyle}"
                               FontSize="14"
                               VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsFoldersTabActive}" Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource PrimaryDarkText}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding IsFoldersTabActive}" Value="False">
                                    <Setter Property="TextColor" Value="{StaticResource TextTertiary}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </StackLayout>
                </Border>
            </Grid>
        </Border>

        <!-- Content Area -->
        <ScrollView Grid.Row="2" 
                    Padding="20,0,20,24">

            <StackLayout Spacing="12">

                <!-- Empty State -->
                <StackLayout Spacing="32" 
                             Padding="40,80"
                             VerticalOptions="CenterAndExpand"
                             IsVisible="{Binding IsEmpty}">

                    <Border WidthRequest="120" HeightRequest="120"
                            BackgroundColor="{StaticResource ElevatedSurface}"
                            StrokeShape="RoundRectangle 32"
                            Stroke="{StaticResource BorderPrimary}"
                            HorizontalOptions="Center">

                        <Border.Shadow>
                            <Shadow Brush="#25000000" Offset="0,12" Radius="32" Opacity="0.15" />
                        </Border.Shadow>

                        <StackLayout Spacing="8" VerticalOptions="Center">
                            <Label Text="folder_open"
                                   FontFamily="MaterialIcons"
                                   FontSize="48"
                                   TextColor="{StaticResource TextTertiary}"
                                   HorizontalOptions="Center" />

                            <Label Text="folder_add"
                                   FontFamily="MaterialIcons"
                                   FontSize="24"
                                   TextColor="{StaticResource Primary}"
                                   HorizontalOptions="Center" />
                        </StackLayout>
                    </Border>

                    <StackLayout Spacing="16">
                        <Label Text="Pasta Vazia"
                               Style="{StaticResource TitleStyle}"
                               FontSize="22"
                               HorizontalTextAlignment="Center"
                               TextColor="{StaticResource TextSecondary}" />

                        <Label Text="Esta pasta ainda não possui contas ou subpastas. Use os botões + para adicionar itens."
                               Style="{StaticResource BodyStyle}"
                               HorizontalTextAlignment="Center"
                               Opacity="0.8" />
                    </StackLayout>
                </StackLayout>

                <!-- Accounts Content -->
                <StackLayout IsVisible="{Binding IsAccountsTabActive}">
                    <CollectionView ItemsSource="{Binding Accounts}"
                                    IsVisible="{Binding HasAccounts}">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="12"/>
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Account">
                                <SwipeView>
                                    <SwipeView.RightItems>
                                        <SwipeItems>
                                            <SwipeItem Text="Editar"
                                                       BackgroundColor="{StaticResource Primary}"
                                                       Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:FolderPageViewModel}}, Path=EditAccountInFolderCommand}"
                                                       CommandParameter="{Binding .}" />
                                            <SwipeItem Text="Excluir"
                                                       BackgroundColor="{StaticResource Error}"
                                                       Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:FolderPageViewModel}}, Path=DeleteAccountInFolderCommand}"
                                                       CommandParameter="{Binding .}" />
                                        </SwipeItems>
                                    </SwipeView.RightItems>

                                    <Border Style="{StaticResource PremiumListItemStyle}">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">

                                            <!-- Account Icon -->
                                            <Border WidthRequest="48" HeightRequest="48"
                                                    BackgroundColor="{Binding Color, Converter={StaticResource HexToColorConverter}}"
                                                    StrokeShape="RoundRectangle 14"
                                                    Grid.Column="0"
                                                    VerticalOptions="Center">

                                                <Border.Shadow>
                                                    <Shadow Brush="{Binding Color, Converter={StaticResource HexToColorConverter}}" 
                                                            Offset="0,4" Radius="12" Opacity="0.3" />
                                                </Border.Shadow>

                                                <Label Text="key"
                                                       FontFamily="MaterialIcons"
                                                       FontSize="20"
                                                       TextColor="{StaticResource PrimaryDarkText}"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                            </Border>

                                            <!-- Account Info -->
                                            <StackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                                <Label Text="{Binding Title}"
                                                       Style="{StaticResource TitleStyle}"
                                                       FontSize="16"
                                                       TextColor="{StaticResource TextPrimary}" />

                                                <Label Text="{Binding Username}"
                                                       Style="{StaticResource CaptionStyle}"
                                                       IsVisible="{Binding Username, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                                                       Opacity="0.8" />
                                            </StackLayout>

                                            <!-- Arrow -->
                                            <Label Grid.Column="2"
                                                   Text="chevron_right"
                                                   FontFamily="MaterialIcons"
                                                   FontSize="20"
                                                   TextColor="{StaticResource TextTertiary}"
                                                   VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </SwipeView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>

                <!-- Folders Content -->
                <StackLayout IsVisible="{Binding IsFoldersTabActive}">
                    <CollectionView ItemsSource="{Binding SubFolders}">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="12"/>
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Folder">
                                <SwipeView>
                                    <SwipeView.RightItems>
                                        <SwipeItems>
                                            <SwipeItem Text="Excluir"
                                                       BackgroundColor="{StaticResource Error}"
                                                       Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:FolderPageViewModel}}, Path=DeleteSubFolderCommand}"
                                                       CommandParameter="{Binding .}" />
                                        </SwipeItems>
                                    </SwipeView.RightItems>

                                    <Border Style="{StaticResource PremiumListItemStyle}">

                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:FolderPageViewModel}}, Path=OpenSubFolderCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>

                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">

                                            <!-- Folder Icon -->
                                            <Border WidthRequest="48" HeightRequest="48"
                                                    BackgroundColor="{Binding Color, Converter={StaticResource HexToColorConverter}}"
                                                    StrokeShape="RoundRectangle 14"
                                                    Grid.Column="0"
                                                    VerticalOptions="Center">

                                                <Border.Shadow>
                                                    <Shadow Brush="{Binding Color, Converter={StaticResource HexToColorConverter}}" 
                                                            Offset="0,4" Radius="12" Opacity="0.3" />
                                                </Border.Shadow>

                                                <Label Text="folder"
                                                       FontFamily="MaterialIcons"
                                                       FontSize="20"
                                                       TextColor="{StaticResource PrimaryDarkText}"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                            </Border>

                                            <!-- Folder Info -->
                                            <StackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                                <Label Text="{Binding Title}"
                                                       Style="{StaticResource TitleStyle}"
                                                       FontSize="16"
                                                       TextColor="{StaticResource TextPrimary}" />

                                                <Label Text="Subpasta"
                                                       Style="{StaticResource CaptionStyle}"
                                                       Opacity="0.8" />
                                            </StackLayout>

                                            <!-- Arrow -->
                                            <Label Grid.Column="2"
                                                   Text="chevron_right"
                                                   FontFamily="MaterialIcons"
                                                   FontSize="20"
                                                   TextColor="{StaticResource TextTertiary}"
                                                   VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </SwipeView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>
            </StackLayout>
        </ScrollView>

        <StackLayout Grid.Row="3" 
                     Orientation="Horizontal"
                     HorizontalOptions="End"
                     Spacing="16"
                     Margin="20,16,20,32">

            <Border WidthRequest="56" HeightRequest="56"
                    BackgroundColor="{StaticResource Primary}"
                    StrokeShape="RoundRectangle 20"
                    IsVisible="{Binding IsAccountsTabActive}"
                    HorizontalOptions="End">

                <Border.Shadow>
                    <Shadow Brush="{StaticResource Primary}" Offset="0,8" Radius="20" Opacity="0.25" />
                </Border.Shadow>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AddNewItemCommand}" />
                </Border.GestureRecognizers>

                <Grid>
                    <Label Text="key"
                           FontFamily="MaterialIcons"
                           FontSize="24"
                           TextColor="{StaticResource PrimaryDarkText}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center" />
                </Grid>
            </Border>

            <Border WidthRequest="56" HeightRequest="56"
                    BackgroundColor="{StaticResource Secondary}"
                    StrokeShape="RoundRectangle 20"
                    IsVisible="{Binding IsFoldersTabActive}"
                    HorizontalOptions="End">

                <Border.Shadow>
                    <Shadow Brush="{StaticResource Secondary}" Offset="0,8" Radius="20" Opacity="0.25" />
                </Border.Shadow>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AddNewSubFolderCommand}" />
                </Border.GestureRecognizers>

                <Grid>
                    <Label Text="create_new_folder"
                           FontFamily="MaterialIcons"
                           FontSize="24"
                           TextColor="{StaticResource SecondaryDarkText}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center" />
                </Grid>
            </Border>
        </StackLayout>
    </Grid>
</ContentPage>